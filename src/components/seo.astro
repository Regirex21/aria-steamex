---
// src/components/seo.astro
// Componente central de SEO. Lo usan baselayout y acrislayout.
import { getLocalePair } from "../config/routes";

interface Props {
  title: string;
  description: string;
  lang?: string;        // "es" | "en"
  image?: string;       // ruta desde la raíz, ej: /assets/logos/aria-horizontal.png
  team?: string;        // "aria" | "acris"
}

const {
  title,
  description,
  lang = "es",
  image = "/assets/logos/aria-horizontal.png",
  team = "aria",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const favicon = team === "acris" ? "/favicon-acris.png" : "/favicon-aria.png";
const siteName = team === "acris" ? "ACRIS STEAMEX" : "ARIA STEAMEX";
const ogLocale = lang === "en" ? "en_US" : "es_MX";

// hreflang: buscar el par ES/EN de la página actual
const localePair = getLocalePair(Astro.url.pathname);
const esURL = localePair ? new URL(localePair.es, Astro.site) : null;
const enURL = localePair ? new URL(localePair.en, Astro.site) : null;
---

<!-- Básicos -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href={favicon} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- hreflang: versiones por idioma (solo si la página existe en ambos) -->
{esURL && enURL && (
  <>
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />
  </>
)}

<!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
