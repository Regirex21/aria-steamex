---
/**
 * Laurel.astro  (motivo romano)
 * Rama o corona de laurel dibujada a mano en SVG. Usa currentColor.
 *
 * Props:
 *  - variant: "rama" | "corona"   (default "rama"; la corona son dos ramas espejadas)
 *  - flip:    boolean             (espeja horizontalmente; default false)
 *  - size:    number | string     (ancho; numero = px; default 160)
 *  - leaves:  number              (pares de hojas por rama; default 9)
 *  - class:   string              (clase extra para el <svg>)
 */
interface Props {
  variant?: "rama" | "corona";
  flip?: boolean;
  size?: number | string;
  leaves?: number;
  class?: string;
}
const { variant = "rama", flip = false, size = 160, leaves = 9, class: cls = "" } = Astro.props;

const R = 80, cx = 100, cy = 100, a0 = 95, a1 = 245;
const rad = (d: number) => (d * Math.PI) / 180;
const f = (n: number) => +n.toFixed(2);
const pt = (deg: number) => [f(cx + R * Math.cos(rad(deg))), f(cy + R * Math.sin(rad(deg)))];
const [sx, sy] = pt(a0);
const [ex, ey] = pt(a1);
const nodes = Array.from({ length: leaves }, (_, i) => {
  const t = i / (leaves - 1);
  const deg = a0 + (a1 - a0) * t;
  const [x, y] = pt(deg);
  return { x, y, rot: f(deg + 90), s: f(1.15 - 0.5 * t) };
});
const leaf = "M0 0 C 6 -9 20 -9 30 0 C 20 9 6 9 0 0Z";
const width = typeof size === "number" ? `${size}px` : size;
const viewBox = variant === "corona" ? "0 0 200 200" : "8 8 112 184";
---

<svg class={`laurel ${cls}`} viewBox={viewBox} style={`width:${width};height:auto;${flip ? "transform:scaleX(-1);" : ""}`} fill="currentColor" aria-hidden="true" focusable="false">
  <g class="branch">
    <path d={`M${sx} ${sy} A${R} ${R} 0 0 1 ${ex} ${ey}`} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    {nodes.map((n) => (
      <g transform={`translate(${n.x} ${n.y}) rotate(${n.rot}) scale(${n.s})`}>
        <path d={leaf} transform="rotate(-36)" fill-opacity=".9" />
        <path d={leaf} transform="rotate(36)" fill-opacity=".9" />
      </g>
    ))}
    <g transform={`translate(${ex} ${ey}) rotate(${f(a1 + 90)}) scale(.6)`}><path d={leaf} /></g>
  </g>
  {variant === "corona" && (
    <g class="branch" transform="translate(200 0) scale(-1 1)">
      <path d={`M${sx} ${sy} A${R} ${R} 0 0 1 ${ex} ${ey}`} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      {nodes.map((n) => (
        <g transform={`translate(${n.x} ${n.y}) rotate(${n.rot}) scale(${n.s})`}>
          <path d={leaf} transform="rotate(-36)" fill-opacity=".9" />
          <path d={leaf} transform="rotate(36)" fill-opacity=".9" />
        </g>
      ))}
      <g transform={`translate(${ex} ${ey}) rotate(${f(a1 + 90)}) scale(.6)`}><path d={leaf} /></g>
    </g>
  )}
</svg>

<style>
  .laurel { display: block; overflow: visible; }
</style>
