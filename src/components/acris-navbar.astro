---
import { acrisBrand } from "../config/acris-brand";

const isEnglish = Astro.url.pathname.startsWith("/acris/en");

const navLinks = isEnglish
  ? [
      { href: "/acris/en/about", label: "About" },
      { href: "/acris/en/ftc", label: "FTC" },
      { href: "/acris/en/join", label: "Join" },
      { href: "/sponsors", label: "Sponsors" },
      { href: "/acris/en/contact", label: "Contact" },
    ]
  : [
      { href: "/acris/nosotros", label: "Nosotros" },
      { href: "/acris/ftc", label: "FTC" },
      { href: "/acris/unirse", label: "Unirse" },
      { href: "/sponsors", label: "Sponsors" },
      { href: "/acris/contacto", label: "Contacto" },
    ];

// Entrada no clicable: la documentación pública de ACRIS aún no existe
const soon = isEnglish
  ? { label: "Public documentation", badge: "Coming soon" }
  : { label: "Documentación pública", badge: "Próximamente" };

// Mapea cada ruta ES de ACRIS con su equivalente EN
const routePairs = [
  ["/acris", "/acris/en"],
  ["/acris/nosotros", "/acris/en/about"],
  ["/acris/ftc", "/acris/en/ftc"],
  ["/acris/liderazgo", "/acris/en/leadership"],
  ["/acris/unirse", "/acris/en/join"],
  ["/acris/contacto", "/acris/en/contact"],
  ["/acris/documentacion", "/acris/en/documentation"],
];

const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/$/, "") : path;

const currentPath = normalizePath(Astro.url.pathname);
const pair =
  routePairs.find(
    ([es, en]) => normalizePath(es) === currentPath || normalizePath(en) === currentPath
  ) ?? routePairs[0];

const spanishHref = pair[0];
const englishHref = pair[1];

const isCurrent = (href: string) => currentPath === normalizePath(href);
const homeHref = isEnglish ? "/acris/en" : "/acris";
const ariaHref = isEnglish ? "/en" : "/";
---

<header class="nav" data-open="false" data-nav>
  <div class="nav-bar glass-pill shape">
    <a class="brand" href={homeHref} aria-label="ACRIS STEAMEX">
      <span class="mark mark-acris-lanza iso" aria-hidden="true"></span>
      <span class="mark mark-acris-wm wm" aria-hidden="true"></span>
    </a>

    <ul class="nav-links">
      {navLinks.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a></li>
      ))}
      <li>
        <span class="nav-soon" aria-disabled="true" role="link" tabindex="-1">
          {soon.label}
          <span class="soon-badge">{soon.badge}</span>
        </span>
      </li>
    </ul>

    <div class="nav-tools">
      <div class="seg" role="group" aria-label={isEnglish ? "Team" : "Equipo"}>
        <a href={ariaHref}>ARIA</a>
        <a href={homeHref} aria-current="true">ACRIS</a>
      </div>
      <div class="seg" role="group" aria-label={isEnglish ? "Language" : "Idioma"}>
        <a href={spanishHref} hreflang="es" lang="es" aria-label="Ver sitio en español" aria-current={!isEnglish ? "true" : undefined}>ES</a>
        <a href={englishHref} hreflang="en" lang="en" aria-label="View site in English" aria-current={isEnglish ? "true" : undefined}>EN</a>
      </div>
      <button class="menu-btn shape" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label={isEnglish ? "Open menu" : "Abrir menú"}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="menu-panel" class="menu-panel glass-menu" aria-label={isEnglish ? "Main menu" : "Menú principal"}>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}><span>{link.label}</span></a></li>
      ))}
      <li>
        <span class="nav-soon" aria-disabled="true" role="link" tabindex="-1">
          <span>{soon.label}</span>
          <span class="soon-badge">{soon.badge}</span>
        </span>
      </li>
    </ul>
    <div class="menu-tools">
      <div class="seg" role="group" aria-label={isEnglish ? "Team" : "Equipo"}>
        <a href={ariaHref}>ARIA</a>
        <a href={homeHref} aria-current="true">ACRIS</a>
      </div>
      <div class="seg" role="group" aria-label={isEnglish ? "Language" : "Idioma"}>
        <a href={spanishHref} hreflang="es" lang="es" aria-label="Ver sitio en español" aria-current={!isEnglish ? "true" : undefined}>ES</a>
        <a href={englishHref} hreflang="en" lang="en" aria-label="View site in English" aria-current={isEnglish ? "true" : undefined}>EN</a>
      </div>
    </div>
    <div class="menu-tools">
      <a href={acrisBrand.formAlumnos} target="_blank" rel="noopener noreferrer" class="btn">{isEnglish ? "Apply" : "Aplicar"}</a>
      <a href={acrisBrand.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn btn--line">Instagram</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-nav]");
    if (!nav) return;
    const btn = nav.querySelector(".menu-btn");
    const set = (open) => {
      nav.setAttribute("data-open", open ? "true" : "false");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    };
    btn.addEventListener("click", () => set(nav.getAttribute("data-open") !== "true"));
    nav.querySelectorAll(".menu-panel a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.getAttribute("data-open") === "true") { set(false); btn.focus(); }
    });
  })();
</script>
