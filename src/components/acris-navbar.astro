---
import { acrisBrand } from "../config/acris-brand";

const isEnglish = Astro.url.pathname.startsWith("/acris/en");

const navLinks = isEnglish
  ? [
      { href: "/acris/en/about", label: "About" },
      { href: "/acris/en/ftc", label: "FTC" },
      { href: "/acris/en/join", label: "Join" },
      { href: "/sponsors", label: "Sponsors" },
      { href: "/acris/en/contact", label: "Contact" },
    ]
  : [
      { href: "/acris/nosotros", label: "Nosotros" },
      { href: "/acris/ftc", label: "FTC" },
      { href: "/acris/unirse", label: "Unirse" },
      { href: "/sponsors", label: "Sponsors" },
      { href: "/acris/contacto", label: "Contacto" },
    ];

// Mapea cada ruta ES de ACRIS con su equivalente EN
const routePairs = [
  ["/acris", "/acris/en"],
  ["/acris/nosotros", "/acris/en/about"],
  ["/acris/ftc", "/acris/en/ftc"],
  ["/acris/liderazgo", "/acris/en/leadership"],
  ["/acris/unirse", "/acris/en/join"],
  ["/acris/contacto", "/acris/en/contact"],
];

const normalizePath = (path) =>
  path.length > 1 ? path.replace(/\/$/, "") : path;

const currentPath = normalizePath(Astro.url.pathname);
const pair =
  routePairs.find(
    ([es, en]) => normalizePath(es) === currentPath || normalizePath(en) === currentPath
  ) ?? routePairs[0];

const spanishHref = pair[0];
const englishHref = pair[1];
---

<header class="sticky top-0 z-50 border-b border-white/10 glass">
  <nav class="container-site h-20 flex items-center justify-between">

    <a href={isEnglish ? "/acris/en" : "/acris"} class="flex items-center gap-3 group flex-shrink-0">
      <img
        src="/assets/logos/acris.png"
        alt="ACRIS STEAMEX Logo"
        class="h-16 w-auto flex-shrink-0 transition duration-300 group-hover:scale-105"
      />
    </a>

    <div class="hidden md:flex gap-8 text-sm font-medium">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <div class="hidden md:flex items-center gap-3">

      <!-- Selector de idioma ES / EN -->
      <div class="flex items-center rounded-full border border-white/10 bg-white/5 p-1 text-xs font-medium">
        <a
          href={spanishHref}
          class={`px-3 py-2 rounded-full transition ${!isEnglish ? "bg-white text-black" : "text-white/65 hover:text-white"}`}
          aria-label="Ver sitio en español"
        >ES</a>
        <a
          href={englishHref}
          class={`px-3 py-2 rounded-full transition ${isEnglish ? "bg-white text-black" : "text-white/65 hover:text-white"}`}
          aria-label="View site in English"
        >EN</a>
      </div>

      <!-- Selector de equipo ARIA / ACRIS -->
      <div class="flex items-center rounded-full border border-white/10 bg-white/5 p-1 text-xs font-semibold">
        <a href={isEnglish ? "/en" : "/"} class="px-3 py-2 rounded-full text-white/65 hover:text-white transition">ARIA</a>
        <a href={isEnglish ? "/acris/en" : "/acris"} class="px-3 py-2 rounded-full bg-white text-black">ACRIS</a>
      </div>

      <a href={acrisBrand.formAlumnos} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
        {isEnglish ? "Apply" : "Aplicar"}
      </a>

      <a href={acrisBrand.instagramUrl} target="_blank" class="btn-primary text-sm">
        Instagram
      </a>

    </div>

    <!-- Botón de menú (solo móvil) -->
    <button
      id="menu-toggle"
      type="button"
      class="md:hidden flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-white/5 flex-shrink-0"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

  </nav>

  <!-- Panel de menú móvil -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 glass">
    <div class="container-site py-6 flex flex-col gap-1">

      {navLinks.map((link) => (
        <a href={link.href} class="nav-link py-3 text-base">{link.label}</a>
      ))}

      <div class="h-px bg-white/10 my-3"></div>

      <div class="flex items-center gap-3 mb-4">
        <a href={isEnglish ? "/en" : "/"} class="px-3 py-2 rounded-full text-xs font-semibold border border-white/10 text-white/65">ARIA</a>
        <a href={isEnglish ? "/acris/en" : "/acris"} class="px-3 py-2 rounded-full text-xs font-semibold bg-white text-black">ACRIS</a>
      </div>

      <div class="flex items-center rounded-full border border-white/10 bg-white/5 p-1 text-xs font-medium w-fit mb-4">
        <a
          href={spanishHref}
          class={`px-3 py-2 rounded-full transition ${!isEnglish ? "bg-white text-black" : "text-white/65 hover:text-white"}`}
          aria-label="Ver sitio en español"
        >ES</a>
        <a
          href={englishHref}
          class={`px-3 py-2 rounded-full transition ${isEnglish ? "bg-white text-black" : "text-white/65 hover:text-white"}`}
          aria-label="View site in English"
        >EN</a>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href={acrisBrand.formAlumnos} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
          {isEnglish ? "Apply" : "Aplicar"}
        </a>
        <a href={acrisBrand.instagramUrl} target="_blank" class="btn-primary text-sm">
          Instagram
        </a>
      </div>

    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    if (!toggle || !menu) return;

    const closeMenu = () => {
      menu.classList.add("hidden");
      iconOpen.classList.remove("hidden");
      iconClose.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      if (isOpen) {
        closeMenu();
      } else {
        menu.classList.remove("hidden");
        iconOpen.classList.add("hidden");
        iconClose.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
      }
    });

    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  })();
</script>
