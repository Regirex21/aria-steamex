---
const isEnglish = Astro.url.pathname.startsWith("/en");

const navLinks = isEnglish
  ? [
      { href: "/en/about_us", label: "About Us" },
      { href: "/en/first", label: "FIRST" },
      { href: "/en/join", label: "Join" },
      { href: "/en/sponsors", label: "Sponsors" },
      { href: "/en/impact", label: "Public documentation" },
      { href: "/en/contact", label: "Contact" },
    ]
  : [
      { href: "/nosotras", label: "Nosotras" },
      { href: "/first", label: "FIRST" },
      { href: "/unirse", label: "Unirse" },
      { href: "/sponsors", label: "Sponsors" },
      { href: "/impacto", label: "Documentación pública" },
      { href: "/contacto", label: "Contacto" },
    ];

const routePairs = [
  ["/", "/en"],
  ["/nosotras", "/en/about_us"],
  ["/first", "/en/first"],
  ["/unirse", "/en/join"],
  ["/sponsors", "/en/sponsors"],
  ["/contacto", "/en/contact"],
  ["/liderazgo", "/en/leadership"],
  ["/impacto", "/en/impact"],
  ["/impacto/procesos", "/en/impact/processes"],
  ["/impacto/ingenieria", "/en/impact/engineering"],
  ["/impacto/negocios", "/en/impact/business"],
  ["/impacto/cads", "/en/impact/cads"],
  ["/impacto/branding", "/en/impact/visual-identity"],
  ["/impacto/revista", "/en/impact/magazine"],
];

const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/$/, "") : path;

const currentPath = normalizePath(Astro.url.pathname);
const pair =
  routePairs.find(([es, en]) => normalizePath(es) === currentPath || normalizePath(en) === currentPath) ??
  routePairs[0];

const spanishHref = pair[0];
const englishHref = pair[1];

const isCurrent = (href: string) =>
  currentPath === normalizePath(href) ||
  (href.length > 3 && href !== "/en" && currentPath.startsWith(normalizePath(href) + "/"));

const acrisHref = isEnglish ? "/acris/en" : "/acris";
const homeHref = isEnglish ? "/en" : "/";
const applyHref = isEnglish ? "/en/join" : "/unirse";
---

<header class="nav" data-open="false" data-nav>
  <div class="nav-bar glass-pill shape">
    <a class="brand" href={homeHref} aria-label="ARIA STEAMEX">
      <span class="mark mark-aria-iso iso" aria-hidden="true"></span>
      <span class="mark mark-aria-wm wm" aria-hidden="true"></span>
    </a>

    <ul class="nav-links">
      {navLinks.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a></li>
      ))}
    </ul>

    <div class="nav-tools">
      <div class="seg" role="group" aria-label={isEnglish ? "Team" : "Equipo"}>
        <a href={homeHref} aria-current="true">ARIA</a>
        <a href={acrisHref}>ACRIS</a>
      </div>
      <div class="seg" role="group" aria-label={isEnglish ? "Language" : "Idioma"}>
        <a href={spanishHref} hreflang="es" lang="es" aria-label="Ver sitio en español" aria-current={!isEnglish ? "true" : undefined}>ES</a>
        <a href={englishHref} hreflang="en" lang="en" aria-label="View site in English" aria-current={isEnglish ? "true" : undefined}>EN</a>
      </div>
      <button class="menu-btn shape" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label={isEnglish ? "Open menu" : "Abrir menú"}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="menu-panel" class="menu-panel glass-menu" aria-label={isEnglish ? "Main menu" : "Menú principal"}>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}><span>{link.label}</span></a></li>
      ))}
    </ul>
    <div class="menu-tools">
      <div class="seg" role="group" aria-label={isEnglish ? "Team" : "Equipo"}>
        <a href={homeHref} aria-current="true">ARIA</a>
        <a href={acrisHref}>ACRIS</a>
      </div>
      <div class="seg" role="group" aria-label={isEnglish ? "Language" : "Idioma"}>
        <a href={spanishHref} hreflang="es" lang="es" aria-label="Ver sitio en español" aria-current={!isEnglish ? "true" : undefined}>ES</a>
        <a href={englishHref} hreflang="en" lang="en" aria-label="View site in English" aria-current={isEnglish ? "true" : undefined}>EN</a>
      </div>
    </div>
    <div class="menu-tools">
      <a href={applyHref} class="btn">{isEnglish ? "Apply" : "Aplicar"}</a>
      <a href="https://www.instagram.com/aria.steamex/" target="_blank" rel="noopener noreferrer" class="btn btn--line">Instagram</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-nav]");
    if (!nav) return;
    const btn = nav.querySelector(".menu-btn");
    const set = (open) => {
      nav.setAttribute("data-open", open ? "true" : "false");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    };
    btn.addEventListener("click", () => set(nav.getAttribute("data-open") !== "true"));
    nav.querySelectorAll(".menu-panel a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.getAttribute("data-open") === "true") { set(false); btn.focus(); }
    });
  })();
</script>
