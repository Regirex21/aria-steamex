---
import AcrisLayout from "../../../layouts/acrislayout.astro";
import { acrisBrand } from "../../../config/acris-brand";
---

<AcrisLayout title="Contact | ACRIS STEAMEX" lang="en">
  <main class="overflow-hidden">

    <section class="container-site pt-24 pb-20 relative overflow-hidden">
      <div class="glow-orb w-56 h-56 top-8 right-16" style="background: rgba(178,19,24,.25)"></div>
      <div class="relative z-10 max-w-4xl">
        <p class="text-sm uppercase tracking-[0.28em] text-white/50 mb-5 reveal show">Contact</p>
        <h1 class="text-6xl md:text-8xl leading-none mb-8 reveal show">Let's talk</h1>
        <p class="serif text-xl md:text-2xl text-white/75 max-w-2xl leading-relaxed reveal show">
          Want to join, collaborate, or support ACRIS? We're one message away.
        </p>
      </div>
    </section>

    <section class="container-site pb-32">
      <div class="grid md:grid-cols-2 gap-6">

        <a href={"mailto:" + acrisBrand.email} class="glass rounded-3xl p-8 reveal block hover:bg-white/10 transition">
          <p class="text-sm uppercase tracking-[0.28em] text-white/45 mb-4">Email</p>
          <h3 class="text-2xl mb-2 break-words">{acrisBrand.email}</h3>
          <p class="text-white/60">Reach out for questions, partnerships, or press.</p>
        </a>

        <a href={acrisBrand.instagramUrl} target="_blank" rel="noopener noreferrer" class="glass rounded-3xl p-8 reveal delay-1 block hover:bg-white/10 transition">
          <p class="text-sm uppercase tracking-[0.28em] text-white/45 mb-4">Instagram</p>
          <h3 class="text-2xl mb-2">{acrisBrand.instagram}</h3>
          <p class="text-white/60">Follow us to see the team's day to day.</p>
        </a>

        <div class="glass rounded-3xl p-8 reveal delay-2">
          <p class="text-sm uppercase tracking-[0.28em] text-white/45 mb-4">Location</p>
          <h3 class="text-2xl mb-2">{acrisBrand.city}</h3>
          <p class="text-white/60">{acrisBrand.country}</p>
        </div>

        <a href="/acris/en/join" class="rounded-3xl p-8 reveal delay-3 border edge-bronze block hover:opacity-90 transition"
          style="background: linear-gradient(120deg, #250505 0%, #3a0709 100%);">
          <p class="text-sm uppercase tracking-[0.28em] mb-4" style="color: var(--accent)">Recruitment</p>
          <h3 class="text-2xl mb-2">I want to join</h3>
          <p class="text-white/60">Go straight to the applicant form.</p>
        </a>

      </div>
    </section>

  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const items = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add("show"); });
      }, { threshold: 0.15 });
      items.forEach((i) => observer.observe(i));
    });
  </script>
</AcrisLayout>
