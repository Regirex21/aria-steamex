---
// src/pages/acris/en/leadership.astro
import AcrisLayout from "../../../layouts/acrislayout.astro";
import Laurel from "../../../components/roma/Laurel.astro";
import Columna from "../../../components/roma/Columna.astro";
import Mosaico from "../../../components/roma/Mosaico.astro";
import Inscripcion from "../../../components/roma/Inscripcion.astro";

const t = {
  kicker: "Meet the leadership",
  h1: "The people who guide the team",
  lede: "Coaches and mentors committed to shaping a new generation in STEM.",
  director: {
    n: "I", role: "National Director · Project STEAMEX", name: "Abraham Martínez",
    img: "/assets/mentoras/abraham.png",
    bio: "Leads the institutional vision of Project STEAMEX and supports the strategic growth of high-impact STEM initiatives.",
  },
  coaches: [
    { n: "II", role: "Head Coach", name: "Regina Servín", img: "/assets/mentoras/rex.png",
      bio: "Leads the team's technical areas including mechanics, programming, and documentation. Oversees development processes, competitive strategy, and internal technical training." },
    { n: "III", role: "Coach", name: "Isis Reyes", img: "/assets/mentoras/mei.jpeg",
      bio: "In charge of sponsorship, impact, and the team's image. Coordinates partnerships, outreach, branding, and institutional communication strategies." },
  ],
  mentors: { k: "Mentors", h: "Driving key areas", area: "Area to be confirmed", name: "To be confirmed", p: "Members to be confirmed." },
  cta: { h: "Want to support this mission?", p: "We're looking for mentors and allies ready to build the future.", b: "Contact", href: "/acris/en/contact" },
};
---

<AcrisLayout
  title="Leadership | Director and Mentors at ACRIS STEAMEX"
  description="Meet who leads ACRIS STEAMEX and the mentors who support FTC team 35735 in Mexico City."
  lang="en"
>
  <main>

    <section class="hero" aria-labelledby="l-title">
      <div class="wrap hero-in">
        <div class="hero-laurel" aria-hidden="true"><Laurel variant="corona" size={84} /></div>
        <Inscripcion size="xs" align="center" class="kick">{t.kicker}</Inscripcion>
        <h1 id="l-title">{t.h1}</h1>
        <p class="serif lede">{t.lede}</p>
      </div>
    </section>

    <section class="dir marble" aria-label={t.director.name}>
      <div class="wrap dir-in">
        <div class="arco-wrap">
          <div class="arco"><img src={t.director.img} alt={t.director.name} loading="eager" decoding="async" /></div>
        </div>
        <div class="who">
          <Inscripcion size="xs" numeral={t.director.n} class="who-k">{t.director.role}</Inscripcion>
          <h2>{t.director.name}</h2>
          <p>{t.director.bio}</p>
        </div>
      </div>
    </section>

    <section class="coaches" aria-label="Coaches">
      <div class="wrap coaches-in">
        {t.coaches.map((c, i) => (
          <>
            {i === 1 && <div class="col" aria-hidden="true"><Columna height={320} /></div>}
            <article class="coach">
              <div class="arco-wrap arco-wrap--s">
                <div class="arco"><img src={c.img} alt={c.name} loading="lazy" decoding="async" /></div>
              </div>
              <Inscripcion size="xs" numeral={c.n} class="kick">{c.role}</Inscripcion>
              <h3>{c.name}</h3>
              <p>{c.bio}</p>
            </article>
          </>
        ))}
      </div>
    </section>

    <section class="mentors" aria-labelledby="m-title">
      <div class="wrap mentors-in">
        <div>
          <Inscripcion size="xs" class="kick">{t.mentors.k}</Inscripcion>
          <h2 id="m-title">{t.mentors.h}</h2>
        </div>
        <div class="nicho">
          <Inscripcion size="xs" align="center" class="nicho-k">{t.mentors.area}</Inscripcion>
          <p class="nicho-n">{t.mentors.name}</p>
          <p class="nicho-p">{t.mentors.p}</p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap cta-in">
        <h2>{t.cta.h}</h2>
        <div>
          <p>{t.cta.p}</p>
          <a href={t.cta.href} class="btn">{t.cta.b}<svg class="arw arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></a>
        </div>
      </div>
      <div class="cta-band" aria-hidden="true"><Mosaico variant="meandro" size={26} /></div>
    </section>

  </main>
</AcrisLayout>

<style>
  :global(.kick) { color: var(--accent-ink); }
  .arw { width: 1em; height: 1em; flex: none; transition: transform var(--dur) var(--ease); }

  .hero { background: var(--bg); padding-block: clamp(4.5rem, 9vw, 8rem); }
  .hero-in { display: grid; justify-items: center; text-align: center; }
  .hero-laurel { color: var(--decor); margin-bottom: var(--s-5); }
  .hero h1 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); font-size: clamp(2.4rem, 1.6rem + 2.8vw, 3.75rem); line-height: 1.02; margin: var(--s-4) 0 var(--s-5); max-width: 18ch; }
  .lede { font-size: clamp(1.1rem, 1rem + .5vw, 1.4rem); color: var(--ink-2); max-width: 42ch; line-height: 1.45; }

  .marble {
    background-color: #F5F1EC;
    background-image:
      linear-gradient(118deg, transparent 0 22%, rgba(90, 21, 20, .045) 22.1%, transparent 22.5% 71%, rgba(165, 100, 36, .06) 71.1%, transparent 71.6%),
      radial-gradient(ellipse at 20% 15%, rgba(255, 255, 255, .9), transparent 55%),
      radial-gradient(ellipse at 85% 80%, rgba(220, 205, 190, .5), transparent 60%);
  }

  .arco-wrap { position: relative; width: min(100%, 300px); }
  .arco-wrap--s { width: min(100%, 240px); margin-bottom: var(--s-5); }
  .arco { aspect-ratio: 4 / 5; border-radius: 999px 999px 4px 4px; overflow: hidden; background: var(--bg-2); outline: 1px solid var(--decor); outline-offset: 9px; }
  .arco img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }

  .dir { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .dir-in { display: grid; grid-template-columns: auto minmax(0, 34rem); gap: var(--s-9); align-items: center; justify-content: center; }
  .who h2 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem); line-height: 1.02; margin: var(--s-4) 0; color: var(--stone-ink); }
  .who p { color: var(--stone-ink-2); font-size: var(--t-lg); max-width: 44ch; }
  :global(.who-k) { color: var(--stone-accent); }

  .coaches { background: var(--black-red); padding-block: clamp(4.5rem, 9vw, 8rem); }
  .coaches-in { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  .col { color: var(--decor); align-self: center; opacity: .6; }
  .coach { display: flex; flex-direction: column; align-items: flex-start; }
  .coach h3 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.6rem); line-height: 1.05; margin: var(--s-3) 0 var(--s-3); }
  .coach p { color: var(--ink-2); max-width: 40ch; }

  .mentors { background: var(--bg); padding-block: clamp(4.5rem, 9vw, 8rem); }
  .mentors-in { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-8); align-items: center; }
  .mentors h2 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem); line-height: 1.02; margin-top: var(--s-4); max-width: 14ch; }
  .nicho { width: min(100%, 22rem); justify-self: center; padding: calc(var(--s-9) - .5rem) var(--s-6) var(--s-7); border: 1px dashed rgba(165, 100, 36, .85); border-radius: 999px 999px 4px 4px; text-align: center; background: var(--bg-2); }
  :global(.nicho-k) { color: var(--ink-2); }
  .nicho-n { font-family: var(--font-title); text-transform: var(--title-transform); font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem); line-height: 1.1; margin: var(--s-3) 0 var(--s-2); color: var(--accent-ink); }
  .nicho-p { color: var(--ink-2); margin: 0; }

  .cta { background: var(--brand); color: #fff; padding-top: clamp(4.5rem, 9vw, 8rem); }
  .cta-in { display: grid; grid-template-columns: 7fr 5fr; gap: var(--s-7); align-items: center; padding-bottom: clamp(4.5rem, 9vw, 8rem); }
  .cta h2 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem); line-height: 1.02; max-width: 16ch; }
  .cta p { font-size: var(--t-lg); margin-bottom: var(--s-5); max-width: 34ch; }
  .cta .btn { --btn-bg: #0A0102; --btn-ink: #fff; --btn-fill: var(--gold); --btn-fill-ink: #0A0102; }
  .cta-band { background: var(--bg); color: var(--decor); padding-block: 9px; border-top: 1px solid rgba(165, 100, 36, .5); }

  @media (max-width: 960px) {
    .coaches-in { grid-template-columns: 1fr; gap: var(--s-8); }
    .col { display: none; }
  }
  @media (max-width: 860px) {
    .hero { padding-block: var(--s-8) var(--s-7); }
    .dir, .coaches, .mentors { padding-block: var(--s-8); }
    .dir-in, .mentors-in, .cta-in { grid-template-columns: 1fr; gap: var(--s-7); }
    .dir-in { justify-items: center; }
    .who { justify-self: start; }
    .cta { padding-top: var(--s-8); }
    .cta-in { padding-bottom: var(--s-8); }
  }
</style>
