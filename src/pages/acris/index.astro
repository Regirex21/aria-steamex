---
import AcrisLayout from "../../layouts/acrislayout.astro";
import AcrisHero from "../../components/acris-hero.astro";
import Laurel from "../../components/roma/Laurel.astro";
import Arcada from "../../components/roma/Arcada.astro";
import Mosaico from "../../components/roma/Mosaico.astro";
import Inscripcion from "../../components/roma/Inscripcion.astro";
import Estandarte from "../../components/roma/Estandarte.astro";
import Sello from "../../components/roma/Sello.astro";
import { acrisBrand } from "../../config/acris-brand";

const marquee = [acrisBrand.number, acrisBrand.tagline, "Equipo mixto", acrisBrand.ages, "100% gratuito", "Ciudad de México"];
const t = {
  "lang": "es",
  "depth": "../../",
  "layoutLang": "",
  "heroProps": "lang=\"es\" joinHref=\"/acris/unirse\" moreHref=\"#ftc\"",
  "about": {
    "kicker": "Quiénes somos",
    "title": "El talento no tiene género.",
    "statement": "ACRIS es un equipo de FIRST Tech Challenge conformado por jóvenes apasionados por la ciencia, la tecnología y la ingeniería. A través de la robótica desarrollamos habilidades técnicas, liderazgo, trabajo en equipo y resolución de problemas.",
    "body": "Buscamos inspirar a más jóvenes a explorar las áreas STEM, construyendo una comunidad donde la curiosidad se convierta en conocimiento y el conocimiento en impacto.",
    "facts": "Somos un equipo mixto, comunitario y gratuito para jóvenes de 12 a 18 años en la Ciudad de México, y el primero y único de su tipo en FTC.",
    "cta": "Conoce al equipo",
    "href": "/acris/nosotros",
    "city": "Ciudad de México"
  },
  "dist": {
    "kicker": "Nuestra distinción",
    "text": "Primer y único equipo comunitario gratuito de FTC en la Ciudad de México."
  },
  "mv": {
    "kicker": "Misión y visión",
    "title": "Formar futuro, dejar legado.",
    "m": {
      "k": "Misión",
      "h": "Formar futuro",
      "p": "Construir una generación capaz de liderar, innovar y resolver problemas complejos a través de la ingeniería, dejando un impacto que trascienda más allá de la competencia."
    },
    "v": {
      "k": "Visión",
      "h": "Dejar legado",
      "p": "Inspirar a más jóvenes a liderar en ciencia, tecnología e ingeniería, convirtiendo a ACRIS en un símbolo de excelencia, perseverancia e innovación."
    }
  },
  "steps": {
    "kicker": "Cómo entras",
    "title": "De tu primer día a la competencia.",
    "list": [
      {
        "n": "I",
        "t": "Llegas",
        "d": "Te registras sin costo. Solo necesitas tener entre 12 y 18 años.",
        "tbd": "[requisitos por confirmar]"
      },
      {
        "n": "II",
        "t": "Aprendes",
        "d": "Capacitaciones de mecánica, programación y diseño.",
        "tbd": "[horario por confirmar]"
      },
      {
        "n": "III",
        "t": "Construyes",
        "d": "Diseñamos y armamos en equipo el robot de la temporada FTC.",
        "tbd": ""
      },
      {
        "n": "IV",
        "t": "Compites",
        "d": "Llevamos el robot a eventos oficiales de FIRST Tech Challenge.",
        "tbd": "[calendario por confirmar]"
      }
    ],
    "ftc": "Qué es FIRST Tech Challenge",
    "ftcHref": "/acris/ftc",
    "docs": "Documentación pública",
    "soon": "Próximamente"
  },
  "join": {
    "kicker": "Próximo paso",
    "title": "Súmate a ACRIS",
    "p": "Si quieres construir robots, competir en FTC y formar parte de una comunidad que crece, este es tu lugar."
  },
  "seal": "ACRIS STEAMEX · FTC 35735 · CIUDAD DE MÉXICO ·"
};
const distText = acrisBrand.distinction + ".";
const steps = t.steps.list;
---

<AcrisLayout
  title="ACRIS STEAMEX | Equipo de robótica FTC 35735"
  description="Equipo mixto, comunitario y gratuito de FIRST Tech Challenge en la Ciudad de México para jóvenes de 12 a 18 años. Piercing the Limits."
>
  <main>
    <AcrisHero lang="es" joinHref="/acris/unirse" moreHref="#ftc" />

    <div class="rm-marq" aria-hidden="true">
      <div class="rm-marq-track">
        <ul>{marquee.map((m) => <li class="wide">{m}</li>)}</ul>
        <ul>{marquee.map((m) => <li class="wide">{m}</li>)}</ul>
      </div>
    </div>

    <section id="quienes" class="section on-stone rm-marble" aria-labelledby="about-title">
      <div class="wrap rm-about">
        <div class="rm-about-body">
          <Inscripcion size="xs" numeral="I" class="rm-kicker">{t.about.kicker}</Inscripcion>
          <h2 id="about-title" class="rm-title">{t.about.title}</h2>
          <p class="rm-statement">{t.about.statement}</p>
          <p class="rm-body">{t.about.body}</p>
          <p class="rm-body">{t.about.facts}</p>
          <a class="btn" href={t.about.href}>{t.about.cta} <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="rm-wreath" aria-hidden="true">
          <Laurel variant="corona" size={280} />
          <div class="rm-wreath-in">
            <Inscripcion size="xs" align="center">FTC</Inscripcion>
            <Inscripcion size="lg" align="center">35735</Inscripcion>
            <Inscripcion size="xs" align="center" class="rm-wreath-city">{t.about.city}</Inscripcion>
          </div>
        </div>
      </div>
    </section>

    <section id="ftc" class="section rm-dist" aria-labelledby="dist-title">
      <div class="wrap">
        <div class="rm-plaque">
          <Inscripcion size="xs" align="center" class="rm-plaque-k">{t.dist.kicker}</Inscripcion>
          <Inscripcion as="h2" id="dist-title" size="xl" align="center" engraved class="rm-plaque-t">{distText}</Inscripcion>
        </div>
      </div>
      <div class="rm-arc rm-arc--d" aria-hidden="true"><Arcada levels={1} bays={22} /></div>
      <div class="rm-arc rm-arc--m" aria-hidden="true"><Arcada levels={1} bays={8} /></div>
    </section>

    <section id="mision" class="section rm-mv" aria-labelledby="mv-title">
      <div class="wrap">
        <div class="rm-head">
          <Inscripcion size="xs" numeral="II" class="rm-kicker">{t.mv.kicker}</Inscripcion>
          <h2 id="mv-title" class="rm-title">{t.mv.title}</h2>
        </div>
        <div class="rm-portico">
          <div class="rm-mv-grid">
            <div>
              <Inscripcion size="xs" class="rm-kicker">{t.mv.m.k}</Inscripcion>
              <h3>{t.mv.m.h}</h3>
              <p>{t.mv.m.p}</p>
            </div>
            <div>
              <Inscripcion size="xs" class="rm-kicker">{t.mv.v.k}</Inscripcion>
              <h3>{t.mv.v.h}</h3>
              <p>{t.mv.v.p}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="rm-band" aria-hidden="true"><Mosaico variant="rombos" size={26} /></div>

    <section class="section rm-via" aria-labelledby="steps-title">
      <div class="wrap">
        <div class="rm-head">
          <Inscripcion size="xs" numeral="III" class="rm-kicker">{t.steps.kicker}</Inscripcion>
          <h2 id="steps-title" class="rm-title">{t.steps.title}</h2>
        </div>
        <ol class="rm-steps">
          {steps.map((s) => (
            <li>
              <div class="rm-stand"><Estandarte numeral={s.n} height={200} /></div>
              <div class="rm-step-text">
                <h3>{s.t}</h3>
                <p>{s.d} {s.tbd && <span class="tbd">{s.tbd}</span>}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="rm-links">
          <a class="btn btn--line" href={t.steps.ftcHref}>{t.steps.ftc} <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <p class="rm-soon"><span>{t.steps.docs}</span> <span class="soon-badge">{t.steps.soon}</span></p>
        </div>
      </div>
    </section>

    <section id="unirse" class="section rm-join" aria-labelledby="join-title">
      <div class="wrap rm-join-grid">
        <div class="rm-seal" aria-hidden="true"><Sello size={180} text={t.seal} spin /></div>
        <div class="rm-join-body">
          <Inscripcion size="xs" class="rm-kicker">{t.join.kicker}</Inscripcion>
          <h2 id="join-title" class="rm-title">{t.join.title}</h2>
          <p>{t.join.p}</p>
          <div class="rm-actions">
            <a class="btn" href={acrisBrand.instagramUrl} target="_blank" rel="noopener">{acrisBrand.instagram}</a>
            <a class="btn btn--line" href={"mailto:" + acrisBrand.email}>{acrisBrand.email}</a>
          </div>
        </div>
      </div>
      <div class="rm-band rm-band--end" aria-hidden="true"><Mosaico variant="meandro" size={26} /></div>
    </section>

  </main>
</AcrisLayout>

<style>
  :global(.rm-kicker) { color: var(--accent-ink); }
  .rm-title { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); letter-spacing: var(--title-tracking); line-height: 1.02; font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem); max-width: 20ch; margin-block: var(--s-4) var(--s-6); }
  .rm-head { margin-bottom: var(--s-9); }
  .rm-marble, .rm-mv, .rm-via { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .rm-dist, .rm-join { padding-top: clamp(4.5rem, 9vw, 8rem); }
  .rm-head .rm-title { margin-bottom: 0; }

  .rm-marq { overflow: hidden; background: var(--brand); color: #fff; padding-block: var(--s-3); }
  .rm-marq-track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .rm-marq ul { display: flex; margin: 0; padding: 0; list-style: none; }
  .rm-marq li { white-space: nowrap; padding-inline: var(--s-6); display: flex; align-items: center; gap: var(--s-6); }
  .rm-marq li::after { content: ""; width: 8px; height: 8px; background: #fff; transform: rotate(45deg); }

  .rm-band { background: var(--bg); color: var(--decor); padding-block: 9px; border-block: 1px solid rgba(165, 100, 36, .5); }
  .rm-band--gold { background: var(--black-red); color: var(--accent-ink); --mos-ink: var(--black-red); }
  .rm-band--end { margin-top: var(--s-9); background: var(--bg); color: var(--decor); border-bottom: 0; }

  .rm-marble {
    background-color: #F5F1EC;
    background-image:
      linear-gradient(118deg, transparent 0 22%, rgba(90, 21, 20, .045) 22.1%, transparent 22.5% 71%, rgba(165, 100, 36, .06) 71.1%, transparent 71.6%),
      radial-gradient(ellipse at 20% 15%, rgba(255, 255, 255, .9), transparent 55%),
      radial-gradient(ellipse at 85% 80%, rgba(220, 205, 190, .5), transparent 60%);
  }
  .rm-marble :global(.rm-kicker) { color: var(--stone-ink-2); }
  .rm-marble .rm-title { color: var(--stone-ink); }
  .rm-about { display: grid; grid-template-columns: minmax(0, 40rem) minmax(0, 1fr); gap: var(--s-9); align-items: center; }
  .rm-statement { font-family: var(--font-serif); font-size: clamp(1.2rem, 1.05rem + .6vw, 1.5rem); line-height: 1.45; color: var(--stone-ink); margin-bottom: var(--s-5); }
  .rm-body { color: var(--stone-ink-2); margin-bottom: var(--s-5); max-width: 56ch; }
  .rm-about-body .btn { margin-top: var(--s-3); }
  .rm-wreath { position: relative; justify-self: center; color: var(--decor); display: grid; place-items: center; }
  .rm-wreath :global(.laurel) { opacity: .65; }
  .rm-wreath-in { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem; color: var(--stone-ink); }
  :global(.rm-wreath-city) { color: var(--stone-ink-2); }

  .rm-dist { background: var(--red-dark); padding-bottom: 0; overflow: hidden; }
  .rm-plaque { max-width: 58rem; margin-inline: auto; padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4.5rem); background: var(--black-red); color: #EADCCF; display: grid; gap: var(--s-5); box-shadow: inset 0 0 0 9px var(--black-red), inset 0 0 0 10px rgba(224, 178, 90, .55), 0 30px 60px -30px rgba(0, 0, 0, .8); }
  :global(.rm-plaque-k) { color: var(--accent-ink); }
  .rm-arc { margin-top: var(--s-9); color: var(--decor); opacity: .45; margin-bottom: -2px; }
  .rm-arc--m { display: none; }

  .rm-mv { background: var(--bg); }
  .rm-portico { display: block; }
  .rm-mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-8); border-top: 3px double rgba(165, 100, 36, .7); padding-top: var(--s-6); }
  .rm-mv-grid > div + div { border-left: 1px solid var(--line); padding-left: var(--s-8); }
  .rm-mv h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); margin-block: var(--s-3); text-transform: uppercase; }
  .rm-mv-grid p { color: var(--ink-2); max-width: 44ch; }

  .rm-via { background: var(--black-red); }
  .rm-steps { list-style: none; margin: 0 0 var(--s-8); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--s-6); --est-cloth: var(--brand); }
  .rm-steps li { position: relative; }
  .rm-stand { display: flex; justify-content: center; position: relative; padding-bottom: 9px; }
  .rm-stand :global(.est) { position: relative; z-index: 1; }
  .rm-stand::after {
    content: ""; position: absolute; left: 0; right: calc(var(--s-6) * -1); bottom: 0; height: 16px;
    background: repeating-linear-gradient(90deg, #4a1a14 0 54px, #1a0505 54px 56px);
    border-block: 1px solid rgba(165, 100, 36, .55);
  }
  .rm-steps li:last-child .rm-stand::after { right: 0; }
  .rm-step-text { padding-top: var(--s-5); padding-right: var(--s-4); }
  .rm-steps h3 { font-size: clamp(1.3rem, 1.1rem + .6vw, 1.6rem); text-transform: uppercase; margin-bottom: var(--s-2); }
  .rm-steps p { color: var(--ink-2); font-size: var(--t-sm); }
  .rm-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5) var(--s-7); }
  .rm-soon { margin: 0; color: var(--ink-2); display: flex; align-items: center; gap: var(--s-3); }

  .rm-join { background: var(--red-dark); padding-bottom: 0; }
  .rm-join-grid { display: grid; grid-template-columns: auto minmax(0, 40rem); gap: var(--s-9); align-items: center; justify-content: center; }
  .rm-seal { color: var(--accent-ink); --sello-ink: var(--accent-ink); }
  .rm-join-body p { color: var(--ink-2); font-size: var(--t-lg); max-width: 46ch; }
  .rm-join .rm-title { margin-bottom: var(--s-4); }
  .rm-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .rm-actions .btn { max-width: 100%; overflow-wrap: anywhere; text-align: center; }
  .rm-join .btn:not(.btn--line) { --btn-bg: var(--ink); --btn-ink: #0A0102; }

  @media (max-width: 1100px) {
    .rm-about { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
    .rm-wreath { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) {
    .rm-mv-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .rm-mv-grid > div + div { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: var(--s-6); }
    .rm-steps { grid-template-columns: 1fr; gap: var(--s-6); }
    .rm-steps li { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: var(--s-5); align-items: center; padding-bottom: var(--s-6); border-bottom: 1px dashed rgba(165, 100, 36, .5); }
    .rm-steps li:last-child { border-bottom: 0; }
    .rm-stand::after { display: none; }
    .rm-stand { padding-bottom: 0; }
    .rm-stand :global(.est) { height: 190px !important; }
    .rm-step-text { padding-top: 0; }
    .rm-join-grid { grid-template-columns: 1fr; justify-items: start; gap: var(--s-7); }
  }
  @media (max-width: 720px) {
    .rm-about { grid-template-columns: 1fr; }
    .rm-arc--d { display: none; }
    .rm-arc--m { display: block; }
    .rm-wreath :global(.laurel) { width: 230px !important; }
    :global(.rm-wreath-city) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rm-marq-track { animation: none; }
  }

</style>
