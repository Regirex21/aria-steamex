---
// src/pages/acris/nosotros.astro
import AcrisLayout from "../../layouts/acrislayout.astro";
import Laurel from "../../components/roma/Laurel.astro";
import Mosaico from "../../components/roma/Mosaico.astro";
import Inscripcion from "../../components/roma/Inscripcion.astro";
import { acrisBrand } from "../../config/acris-brand";
---

<AcrisLayout title="Nosotros | ACRIS STEAMEX">
  <main>

    <section class="nh">
      <div class="wrap nh-in">
        <div class="nh-txt">
          <Inscripcion size="xs" class="k-gold">Nosotros</Inscripcion>
          <h1 class="pg-h1">Precisión, fluidez, <span class="hot">impacto</span>.</h1>
          <p class="pg-lede">ACRIS lleva la robótica competitiva a jóvenes de {acrisBrand.ages} sin importar su contexto.</p>
        </div>
        <div class="nh-wreath" aria-hidden="true">
          <Laurel variant="corona" size={200} />
          <Inscripcion size="lg" align="center" class="nh-acris">ACRIS</Inscripcion>
        </div>
      </div>
    </section>

    <section class="ns on-stone marble" aria-labelledby="story-title">
      <div class="wrap ns-in">
        <div class="ns-head">
          <div>
            <Inscripcion size="xs" align="center" class="k-stone">Nuestra historia</Inscripcion>
            <h2 id="story-title" class="pg-title ns-title">Nacimos para abrir camino</h2>
          </div>
        </div>
        <div class="ns-body">
          <p class="ns-big">ACRIS es un equipo comunitario, independiente y gratuito de FIRST Tech Challenge en la Ciudad de México. Reunimos a jóvenes con pasión por la ciencia, la tecnología y la ingeniería para construir robots, competir y crecer en equipo.</p>
          <p>Creemos que el talento no depende del contexto educativo, sino de la oportunidad. Por eso abrimos un espacio donde la curiosidad se convierte en conocimiento y el conocimiento en impacto.</p>
        </div>
        <Inscripcion as="p" size="md" align="center" class="ns-dist">{acrisBrand.distinction}</Inscripcion>
      </div>
    </section>

    <section class="nm" aria-label="Misión / Visión">
      <div class="nm-a">
        <Inscripcion size="xs" class="nm-k">Misión</Inscripcion>
        <h2>Formar futuro</h2>
        <p>Construir una generación capaz de liderar, innovar y resolver problemas complejos a través de la ingeniería, dejando un impacto que trascienda más allá de la competencia.</p>
      </div>
      <div class="nm-div nm-div--v" aria-hidden="true"><Mosaico variant="rombos" direction="v" size={22} /></div>
      <div class="nm-div nm-div--h" aria-hidden="true"><Mosaico variant="rombos" size={22} /></div>
      <div class="nm-b">
        <Inscripcion size="xs" class="k-gold">Visión</Inscripcion>
        <h2>Dejar legado</h2>
        <p>Inspirar a más jóvenes a liderar en ciencia, tecnología e ingeniería, convirtiendo a ACRIS en un símbolo de excelencia, perseverancia e innovación.</p>
      </div>
    </section>

    <section class="nv on-stone marble" aria-labelledby="vals-title">
      <div class="wrap">
        <div class="nv-head">
          <Inscripcion size="xs" class="k-stone">Lo que nos define</Inscripcion>
          <h2 id="vals-title" class="pg-title nv-title">Nuestros valores</h2>
        </div>
        <ul class="nv-list">
          <li>
            <div class="nv-txt">
              <Inscripcion size="sm" align="center" numeral="I" class="nv-num">Precisión</Inscripcion>
              <p>Como la punta de una lanza, cada acción está calculada.</p>
            </div>
          </li>
          <li>
            <div class="nv-txt">
              <Inscripcion size="sm" align="center" numeral="II" class="nv-num">Velocidad</Inscripcion>
              <p>Diseño aerodinámico: soluciones ágiles y decisiones rápidas.</p>
            </div>
          </li>
          <li>
            <div class="nv-txt">
              <Inscripcion size="sm" align="center" numeral="III" class="nv-num">Innovación</Inscripcion>
              <p>Tomamos ideas del pasado y las transformamos con tecnología.</p>
            </div>
          </li>
          <li>
            <div class="nv-txt">
              <Inscripcion size="sm" align="center" numeral="IV" class="nv-num">Comunidad</Inscripcion>
              <p>Crecemos juntos y abrimos oportunidades a más jóvenes.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <div class="band band--gold" aria-hidden="true"><Mosaico variant="estrellas" size={30} /></div>

    <section class="nc">
      <div class="wrap nc-in">
        <div>
          <h2 class="pg-title nc-title">Sé parte de ACRIS</h2>
          <p class="nc-p">Si buscas aprender, construir y competir, este es tu siguiente paso.</p>
        </div>
        <div class="actions">
          <a href="/acris/unirse" class="btn">Aplicar<svg class="arw arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg></a>
          <a href="/acris/contacto" class="btn btn--line">Contactar</a>
        </div>
      </div>
    </section>

  </main>
</AcrisLayout>

<style>
  .arw { width: 1em; height: 1em; flex: none; }
  :global(.k-gold) { color: var(--accent-ink); }
  :global(.k-stone) { color: var(--stone-ink-2); }
  .pg-h1 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); letter-spacing: var(--title-tracking); line-height: 1.02; font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem); margin: var(--s-4) 0 var(--s-5); }
  .pg-title { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); letter-spacing: var(--title-tracking); line-height: 1.04; font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem); margin: var(--s-4) 0 var(--s-5); }
  .pg-lede { font-family: var(--font-serif); font-size: clamp(1.15rem, 1.02rem + .55vw, 1.4rem); line-height: 1.5; color: var(--ink-2); max-width: 40ch; }
  .band { background: var(--bg); color: var(--decor); padding-block: 9px; border-block: 1px solid rgba(165, 100, 36, .5); }
  .band--gold { background: var(--black-red); color: var(--accent-ink); --mos-ink: var(--black-red); }
  .marble {
    background-color: #F5F1EC;
    background-image:
      linear-gradient(118deg, transparent 0 22%, rgba(90, 21, 20, .045) 22.1%, transparent 22.5% 71%, rgba(165, 100, 36, .06) 71.1%, transparent 71.6%),
      radial-gradient(ellipse at 20% 15%, rgba(255, 255, 255, .9), transparent 55%),
      radial-gradient(ellipse at 85% 80%, rgba(220, 205, 190, .5), transparent 60%);
  }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  .nh { background: var(--bg); padding-block: clamp(4rem, 8vw, 7rem); }
  .nh-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-8); align-items: center; }
  .nh .hot { color: var(--primary-soft); }
  .nh-wreath :global(.laurel) { opacity: .65; }
  .nh-wreath { position: relative; display: grid; place-items: center; color: var(--decor); margin-right: clamp(0rem, 4vw, 4rem); }
  .nh-wreath :global(.nh-acris) { position: absolute; color: var(--ink); }

  .ns { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .ns-in { max-width: 52rem; }
  .ns-head { text-align: center; margin-bottom: var(--s-6); }
  .ns-title { color: var(--stone-ink); margin-bottom: 0; }
  .ns-body { color: var(--stone-ink-2); max-width: 46rem; margin-inline: auto; }
  .ns-body p { margin-bottom: var(--s-5); }
  .ns-big { font-family: var(--font-serif); font-size: clamp(1.2rem, 1.05rem + .6vw, 1.5rem); line-height: 1.5; color: var(--stone-ink); }
  :global(.ns-dist) { color: var(--brand); margin-top: var(--s-7); padding-top: var(--s-6); border-top: 3px double rgba(138, 90, 44, .6); max-width: 40rem; margin-inline: auto; }

  .nm { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
  .nm-a, .nm-b { padding: clamp(4rem, 8vw, 6.5rem) clamp(1.5rem, 5vw, 4.5rem); }
  .nm-a { background: var(--red-dark); display: flex; flex-direction: column; align-items: flex-start; }
  .nm-b { background: var(--bg); }
  .nm-a > *, .nm-b > * { max-width: 34rem; }
  :global(.nm-k) { color: #fff; }
  .nm h2 { font-family: var(--font-title); font-weight: 400; text-transform: var(--title-transform); letter-spacing: var(--title-tracking); line-height: 1.04; font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem); margin: var(--s-4) 0 var(--s-4); }
  .nm p { color: var(--ink-2); }
  .nm-div { background: var(--black-red); color: var(--accent-ink); --mos-ink: var(--black-red); }
  .nm-div--v { width: 22px; }
  .nm-div--h { display: none; }

  .nv { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .nv-title { color: var(--stone-ink); margin-bottom: var(--s-8); }
  .nv-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-7); }
  .nv-list li { border-top: 3px double rgba(138, 90, 44, .55); padding-top: var(--s-5); }
  .nv-txt { text-align: center; }
  :global(.nv-num) { color: var(--stone-ink); margin-bottom: var(--s-3); }
  :global(.nv-num .insc-num) { color: var(--brand); }
  .nv-txt p { color: var(--stone-ink-2); font-size: var(--t-sm); max-width: 26ch; margin-inline: auto; }

  .nc { background: var(--black-red); padding-block: clamp(4rem, 8vw, 6.5rem); }
  .nc-in { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-7); align-items: center; }
  .nc-title { margin-block: 0 var(--s-3); }
  .nc-p { color: var(--ink-2); font-size: var(--t-lg); max-width: 40ch; }

  @media (max-width: 860px) {
    .nh-in { grid-template-columns: 1fr; gap: var(--s-6); }
    .nh-wreath { justify-self: start; margin-right: 0; }
    .nh-wreath :global(.laurel) { width: 160px !important; }
    .nm { grid-template-columns: 1fr; }
    .nm-div--v { display: none; }
    .nm-div--h { display: block; }
    .nv-list { grid-template-columns: 1fr; gap: var(--s-5); }
    .nv-txt { text-align: left; }
    :global(.nv-num) { text-align: left !important; }
    .nv-txt p { margin-inline: 0; }
    .nc-in { grid-template-columns: 1fr; gap: var(--s-6); }
  }
</style>
