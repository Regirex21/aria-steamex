---
// src/pages/contacto.astro
import BaseLayout from "../layouts/baselayout.astro";

const email = "ariasteamex@gmail.com";
const [user, host] = email.split("@");
---

<BaseLayout
  title="Contacto | Escríbele a ARIA STEAMEX"
  description="Escríbenos para unirte, patrocinar o colaborar con ARIA STEAMEX, equipo femenil de FRC 11040 en la Ciudad de México."
>
  <main>

    <section class="wrap c-hero">
      <div class="c-left">
        <p class="wide">Contacto</p>
        <h1>Hablemos</h1>
        <p class="lede">Si quieres unirte, colaborar, patrocinar o conocer más sobre ARIA STEAMEX, aquí es el mejor lugar para empezar.</p>
        <span class="greca" aria-hidden="true"></span>
      </div>

      <div class="c-right">
        <p class="wide">Correo oficial</p>
        <a class="mail" href={"mailto:" + email}>
          <span>{user}</span>
          <span class="at">@{host}<svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
        </a>
        <p class="mail-note">Para alianzas, dudas generales, prensa o propuestas formales.</p>
        <button type="button" class="btn btn--line copy" data-copy={email} data-done="Correo copiado">Copiar correo</button>

        <ul class="rows">
          <li>
            <a class="row" href="https://wa.me/525564876703" target="_blank" rel="noopener noreferrer">
              <span class="wide">WhatsApp</span>
              <span class="row-t"><strong>Coach principal</strong><span>Canal rápido para información, patrocinio o dudas directas.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="row" href="https://instagram.com/aria.steamex" target="_blank" rel="noopener noreferrer">
              <span class="wide">Instagram</span>
              <span class="row-t"><strong>@aria.steamex</strong><span>Avances, convocatorias y vida del equipo.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="help on-stone">
      <div class="wrap help-grid">
        <div>
          <p class="wide help-eyebrow">Podemos ayudarte con</p>
          <h2>Más que preguntas. Oportunidades reales.</h2>
          <p class="help-p">Estamos abiertas a nuevas integrantes, patrocinadores, medios, instituciones educativas y alianzas estratégicas.</p>
        </div>
        <ul class="hl">
          <li>
            <a class="hl-row" href="/unirse">
              <span class="hl-n">01</span>
              <span class="hl-t"><strong>Unirse</strong><span>Proceso de ingreso y convocatorias.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="hl-row" href="/sponsors">
              <span class="hl-n">02</span>
              <span class="hl-t"><strong>Patrocinio</strong><span>Apoyo y colaboración empresarial.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="hl-row" href="mailto:ariasteamex@gmail.com?subject=Escuelas">
              <span class="hl-n">03</span>
              <span class="hl-t"><strong>Escuelas</strong><span>Activaciones y proyectos educativos.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="hl-row" href="mailto:ariasteamex@gmail.com?subject=Medios">
              <span class="hl-n">04</span>
              <span class="hl-t"><strong>Medios</strong><span>Entrevistas, prensa y difusión.</span></span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <div class="mq" aria-hidden="true">
      <div class="mq-track">
        <div class="mq-g"><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i></div>
        <div class="mq-g"><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i><span>Hablemos</span><i></i></div>
      </div>
    </div>

    <section class="cta">
      <div class="wrap cta-in">
        <div>
          <h2>Empecemos una conversación</h2>
          <p>Las grandes oportunidades comienzan con un mensaje.</p>
        </div>
        <div class="cta-actions">
          <a href={"mailto:" + email} class="btn">Enviar correo<svg class="arw arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
          <a href="/sponsors" class="btn btn--line">Ver patrocinadores</a>
        </div>
      </div>
    </section>

  </main>

  <script is:inline>
    document.querySelectorAll("[data-copy]").forEach(function (b) {
      b.addEventListener("click", function () {
        var original = b.textContent;
        var done = function () {
          b.textContent = b.getAttribute("data-done");
          setTimeout(function () { b.textContent = original; }, 1800);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(b.getAttribute("data-copy")).then(done, done);
        } else { done(); }
      });
    });
  </script>
</BaseLayout>

<style>
  .arw { width: 1em; height: 1em; flex: none; transition: transform var(--dur) var(--ease); }

  .c-hero { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-8); padding-block: var(--s-8) var(--s-9); align-items: start; }
  .c-left { position: sticky; top: 112px; }
  .c-left h1 { font-size: clamp(3.4rem, 8vw, 7rem); margin: var(--s-4) 0 var(--s-5); color: var(--cream); }
  .lede { color: var(--ink-2); font-size: var(--t-lg); max-width: 32ch; }
  .c-left .greca { margin-top: var(--s-7); height: 24px; max-width: 320px; }

  .mail {
    position: relative; display: block; margin-top: var(--s-4); padding-bottom: var(--s-4);
    font-family: var(--font-title); font-size: clamp(2.6rem, 11.5vw, 5.6rem); line-height: 1.02;
    color: var(--ink); text-decoration: none; overflow-wrap: anywhere;
  }
  .mail span { display: block; }
  .mail .at { color: var(--accent-ink); }
  .mail .arw { display: inline-block; width: .5em; height: .5em; margin-left: .2em; vertical-align: .05em; transform: rotate(-45deg); }
  .mail::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--accent);
    transform: scaleX(.16); transform-origin: left; transition: transform var(--dur-slow) var(--ease);
  }
  .mail:hover::after, .mail:focus-visible::after { transform: scaleX(1); }
  .mail:hover .arw { transform: rotate(-45deg) translateX(8px); }
  .mail-note { margin: var(--s-4) 0 var(--s-5); color: var(--ink-2); max-width: 44ch; }

  .rows { list-style: none; margin: var(--s-8) 0 0; padding: 0; border-bottom: 1px solid var(--line-strong); }
  .row {
    position: relative; display: grid; grid-template-columns: 8.5rem minmax(0, 1fr) auto; align-items: baseline; gap: var(--s-4);
    padding: var(--s-5) 0; border-top: 1px solid var(--line-strong); color: var(--ink); text-decoration: none;
  }
  .row::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-slow) var(--ease);
  }
  .row:hover::before, .row:focus-visible::before { transform: scaleX(1); }
  .row .wide { color: var(--ink-2); }
  .row-t { display: grid; gap: var(--s-1); transition: transform var(--dur) var(--ease); }
  .row-t strong { font: 400 clamp(1.5rem, 3vw, 2.4rem)/1.1 var(--font-title); }
  .row-t span { color: var(--ink-2); font-size: var(--t-sm); }
  .row .arw { width: 1.6rem; height: 1.6rem; align-self: center; }
  .row:hover .row-t { transform: translateX(8px); }
  .row:hover .arw { transform: translateX(8px); }

  .help { padding-block: var(--s-9); }
  .help-grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-8); }
  .help h2 { font-size: var(--t-2xl); margin: var(--s-4) 0 var(--s-5); max-width: 11ch; }
  .help-p { color: var(--stone-ink-2); max-width: 36ch; font-size: var(--t-lg); }
  .hl { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgba(48, 31, 58, .25); }
  .hl-row {
    position: relative; display: grid; grid-template-columns: 3.4rem minmax(0, 1fr) auto; align-items: center; gap: var(--s-4);
    padding: var(--s-5) 0; border-top: 1px solid rgba(48, 31, 58, .25); color: var(--stone-ink); text-decoration: none;
  }
  .hl-row::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--stone-ink);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-slow) var(--ease);
  }
  .hl-row:hover::before, .hl-row:focus-visible::before { transform: scaleX(1); }
  .hl-n { font-family: var(--font-title); font-size: 1.6rem; color: var(--stone-accent); }
  .hl-t { display: grid; gap: var(--s-1); transition: transform var(--dur) var(--ease); }
  .hl-t strong { font: 400 clamp(1.9rem, 4vw, 3rem)/1.05 var(--font-title); }
  .hl-t span { color: var(--stone-ink-2); }
  .hl-row .arw { width: 1.6rem; height: 1.6rem; }
  .hl-row:hover .hl-t, .hl-row:hover .arw { transform: translateX(8px); }
  .help :global(.wide) { color: var(--stone-ink-2); }

  .mq { background: var(--accent); color: var(--on-accent); overflow: hidden; padding-block: var(--s-4); }
  .mq-track { display: flex; width: max-content; animation: marquee 50s linear infinite; }
  .mq-g { display: flex; align-items: center; gap: var(--s-6); padding-right: var(--s-6); flex: none; }
  .mq-g span { font-family: var(--font-title); font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1; white-space: nowrap; }
  .mq-g i { width: 11px; height: 11px; background: currentColor; transform: rotate(45deg); flex: none; }

  .cta { background: var(--brand); padding-block: var(--s-9); }
  .cta-in { display: grid; grid-template-columns: 1fr auto; gap: var(--s-7); align-items: end; }
  .cta h2 { font-size: var(--t-2xl); max-width: 14ch; }
  .cta p { color: var(--ink-2); margin-top: var(--s-4); font-size: var(--t-lg); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  @media (max-width: 860px) {
    .c-hero, .help-grid, .cta-in { grid-template-columns: 1fr; gap: var(--s-6); }
    .c-left { position: static; }
    .c-hero { padding-block: var(--s-6) var(--s-8); }
    .rows { margin-top: var(--s-7); }
    .row { grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-2) var(--s-4); }
    .row .wide { grid-column: 1 / -1; }
    .row .arw { grid-row: 2; grid-column: 2; }
    .help, .cta { padding-block: var(--s-8); }
  }
</style>
