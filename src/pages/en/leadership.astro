---
// src/pages/en/leadership.astro
import BaseLayout from "../../layouts/baselayout.astro";
---

<BaseLayout
  title="Leadership | Coaches and Mentors at ARIA STEAMEX"
  description="Meet the coaches, mentors and allies training a new generation of women leaders in STEM at ARIA STEAMEX."
  lang="en"
>

  <main class="pg">

    <section class="hero hero-solo">
      <div class="wrap">
        <p class="kicker wide">Meet the leadership</p>
        <h1 class="title">People who build opportunities</h1>
        <p class="lead">ARIA STEAMEX grows thanks to coaches, mentors, and allies committed to training a new generation of women leaders in STEM.</p>
      </div>
    </section>

    <section class="band band--lav on-stone">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap">
        <span class="wide" style="color: var(--stone-ink-2)">Our philosophy</span>
        <h2 class="title quote" style="margin-top: var(--s-4)">To lead is to serve, teach, and raise standards.</h2>
        <p class="quote-p">We are not looking for decorative figures. We look for active leadership: people who teach, guide, demand excellence, and open the way.</p>
      </div>
      <span class="greca greca-bot" aria-hidden="true"></span>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="head">
          <div class="idx" aria-hidden="true">01</div>
          <div>
            <span class="tag wide">Coaches</span>
            <h2 class="title">Direction and institutional leadership</h2>
          </div>
        </div>
        <div class="people">
          <article class="person">
            <div class="photo-corner ph person-ph">
              <img src="/assets/mentoras/abraham.png" alt="Abraham Martínez" loading="lazy" decoding="async" />
            </div>
            <div>
              <span class="role wide">National Director · Project STEAMEX</span>
              <h3>Abraham Martínez</h3>
              <p>Leads the institutional vision of Project STEAMEX and supports the strategic growth of high-impact STEM initiatives.</p>
            </div>
          </article>
          <article class="person">
            <div class="photo-corner photo-corner--alt ph person-ph">
              <img src="/assets/mentoras/rex.png" alt="Regina Servín" loading="lazy" decoding="async" />
            </div>
            <div>
              <span class="role wide">Head Coach</span>
              <h3>Regina Servín</h3>
              <p>Leads the team's technical areas, including mechanics, programming, and documentation. Oversees development processes, competitive strategy, and internal technical training.</p>
            </div>
          </article>
          <article class="person">
            <div class="photo-corner ph person-ph">
              <img src="/assets/mentoras/mei.jpeg" alt="Isis Reyes" loading="lazy" decoding="async" />
            </div>
            <div>
              <span class="role wide">Coach</span>
              <h3>Isis Reyes</h3>
              <p>Responsible for sponsorship, impact, and team image. Coordinates partnerships, outreach, branding, and institutional communication strategies.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <div class="mq"><div class="mq-track"><div class="mq-copy"><span>Mentors</span><span>Coaches</span><span>Allies</span><span>STEM leadership</span><span>Mentors</span><span>Coaches</span><span>Allies</span><span>STEM leadership</span></div><div class="mq-copy" aria-hidden="true"><span>Mentors</span><span>Coaches</span><span>Allies</span><span>STEM leadership</span><span>Mentors</span><span>Coaches</span><span>Allies</span><span>STEM leadership</span></div></div></div>

    <section class="band">
      <div class="wrap">
        <div class="head">
          <div class="idx" aria-hidden="true">02</div>
          <div>
            <span class="tag wide">Mentors</span>
            <h2 class="title">People who drive key areas</h2>
          </div>
        </div>
        <ul class="roster">
          <li>
            <div class="face"><img src="/assets/mentoras/gemma.jpeg" alt="Gemma Navarrete" loading="lazy" decoding="async" /></div>
            <h3>Gemma Navarrete</h3>
            <span class="area wide">Impact</span>
            <p>Outreach and community.</p>
          </li>
          <li>
            <div class="face"><img src="/assets/mentoras/pau.png" alt="Paulina Peña" loading="lazy" decoding="async" /></div>
            <h3>Paulina Peña</h3>
            <span class="area wide">Impact</span>
            <p>Outreach and community.</p>
          </li>
          <li>
            <div class="face"><img src="/assets/mentoras/bri.jpeg" alt="Britany Valadez" loading="lazy" decoding="async" /></div>
            <h3>Britany Valadez</h3>
            <span class="area wide">Mechanics and Programming</span>
            <p>Training and development of technical content.</p>
          </li>
          <li>
            <div class="face"><img src="/assets/mentoras/renata.jpeg" alt="Renata Servín" loading="lazy" decoding="async" /></div>
            <h3>Renata Servín</h3>
            <span class="area wide">Mechanics</span>
            <p>Design, assembly, and manufacturing.</p>
          </li>
          <li>
            <div class="face"><img src="/assets/mentoras/katy.png" alt="Katheryn Azano" loading="lazy" decoding="async" /></div>
            <h3>Katheryn Azano</h3>
            <span class="area wide">Programming</span>
            <p>Software development and automation.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="band band--lav on-stone">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap final">
        <div>
          <h2 class="title">Want to support this mission?</h2>
          <p>We are looking for new mentors, allies, and people ready to build the future.</p>
        </div>
        <div class="actions" style="margin-top: 0">
          <a href="/en/join" class="btn-primary">Apply as a mentor</a>
          <a href="/en/contact" class="btn-secondary">Contact</a>
        </div>
      </div>
    </section>

  </main>

  <style>
  .pg { overflow: clip; }
  .hero { padding-block: var(--s-8) var(--s-9); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); align-items: end; }
  .hero h1 { font-size: var(--t-3xl); line-height: 1.02; max-width: 14ch; }
  .hero-solo h1 { max-width: 16ch; }
  .kicker { display: flex; align-items: center; gap: var(--s-4); color: var(--ink-2); margin-bottom: var(--s-5); }
  .kicker::before { content: ""; width: 48px; height: 1px; background: var(--accent-ink); }
  .lead { font-size: var(--t-lg); color: var(--ink-2); max-width: 52ch; margin-top: var(--s-5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .band { position: relative; padding-block: var(--s-9); }
  .band--lav { background: var(--stone); color: var(--stone-ink); }
  .band--lav p { color: var(--stone-ink-2); }
  .band--lav .greca { color: var(--brand); }
  .band--lav .greca-top { position: absolute; top: 0; left: 0; }
  .band--lav .greca-bot { position: absolute; bottom: 0; left: 0; }
  .band--lav.band { padding-block: calc(var(--s-9) + 14px); }
  .head { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 4fr); gap: var(--s-5); margin-bottom: var(--s-7); align-items: start; }
  .idx { font-family: var(--font-title); font-size: clamp(4rem, 10vw, 8.5rem); line-height: .8; color: var(--decor); }
  .band--lav .idx { color: var(--brand); }
  .head h2 { font-size: var(--t-2xl); max-width: 18ch; }
  .head .tag { display: block; margin-bottom: var(--s-3); color: var(--ink-2); }
  .band--lav .head .tag { color: var(--stone-ink-2); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .rows li { display: grid; grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-5); align-items: baseline; padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  .rows .n { font-family: var(--font-wide); font-size: .6875rem; letter-spacing: .14em; color: var(--accent-ink); transition: transform var(--dur) var(--ease); }
  .rows li:hover .n { transform: translateX(8px); }
  .rows h3 { font-family: var(--font-title); font-size: var(--t-xl); letter-spacing: 0; line-height: 1.1; }
  .rows p { color: var(--ink-2); }
  .band--lav .rows { border-color: rgba(0, 0, 0, .3); }
  .band--lav .rows li { border-color: rgba(0, 0, 0, .15); }
  .band--lav .rows .n { color: var(--brand); }
  .band--lav .rows p { color: var(--stone-ink-2); }
  .ph { width: 100%; aspect-ratio: 4 / 5; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mq { overflow: hidden; border-block: 1px solid var(--line-strong); padding-block: var(--s-4); }
  .mq-track { display: flex; width: max-content; animation: mq-slide 42s linear infinite; }
  .mq-copy { display: flex; flex-shrink: 0; }
  .mq-copy span { font-family: var(--font-title); font-size: var(--t-2xl); line-height: 1.1; white-space: nowrap; display: inline-flex; align-items: center; gap: var(--s-6); padding-right: var(--s-6); }
  .mq-copy span::after { content: ""; width: 12px; height: 12px; background: var(--accent-ink); transform: rotate(45deg); }
  @keyframes mq-slide { to { transform: translateX(-50%); } }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .head { grid-template-columns: 1fr; gap: var(--s-3); }
    .idx { font-size: 4rem; }
    .rows li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s-3) var(--s-4); }
    .rows li p { grid-column: 2; }
    .band { padding-block: var(--s-8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-track { width: auto; flex-wrap: wrap; }
    .mq-copy[aria-hidden="true"] { display: none; }
    .mq-copy { flex-wrap: wrap; }
  }

  .quote { max-width: 24ch; font-size: var(--t-3xl); line-height: 1.02; }
  .quote-p { max-width: 48ch; margin-top: var(--s-6); font-size: var(--t-lg); }
  .people { display: grid; gap: var(--s-9); }
  .person { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s-8); align-items: center; }
  .person:nth-child(even) { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .person:nth-child(even) .person-ph { order: 2; }
  .person-ph { max-width: 440px; width: 100%; }
  .person:nth-child(even) .person-ph { justify-self: end; }
  .person .role { color: var(--accent-ink); display: block; margin-bottom: var(--s-3); }
  .person h3 { font-family: var(--font-title); font-size: var(--t-2xl); letter-spacing: 0; line-height: 1.02; margin-bottom: var(--s-4); }
  .person p { color: var(--ink-2); max-width: 46ch; }
  .roster { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .roster li { display: grid; grid-template-columns: 96px minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr); gap: var(--s-5); align-items: center; padding-block: var(--s-4); border-bottom: 1px solid var(--line); }
  .roster .face { width: 96px; height: 96px; border-radius: 48px 48px 10px 10px; overflow: hidden; }
  .roster .face img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-slow) var(--ease); }
  .roster li:hover .face img { transform: scale(1.08); }
  .roster h3 { font-family: var(--font-title); font-size: var(--t-xl); letter-spacing: 0; line-height: 1.1; }
  .roster .area { color: var(--accent-ink); }
  .roster p { color: var(--ink-2); }
  .final { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-6); }
  .final h2 { font-size: var(--t-3xl); line-height: 1; max-width: 12ch; }
  .final p { max-width: 40ch; margin-top: var(--s-4); font-size: var(--t-lg); }
  @media (max-width: 960px) {
    .person, .person:nth-child(even) { grid-template-columns: 1fr; gap: var(--s-5); }
    .person:nth-child(even) .person-ph { order: 0; justify-self: start; }
    .person-ph { max-width: 320px; }
    .people { gap: var(--s-8); }
    .roster li { grid-template-columns: 72px minmax(0, 1fr); gap: var(--s-2) var(--s-4); }
    .roster .face { width: 72px; height: 72px; border-radius: 36px 36px 8px 8px; grid-row: span 3; }
    .roster li > :not(.face) { grid-column: 2; }
  }
</style>

</BaseLayout>
