---
// src/pages/en/join.astro
import BaseLayout from "../../layouts/baselayout.astro";
---

<BaseLayout title="Join | ARIA STEAMEX" lang="en">

  <main class="pg">

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker wide">Join</p>
          <h1 class="title">Choose your path</h1>
          <p class="lead">ARIA STEAMEX is looking for students eager to grow and mentors ready to empower a new generation.</p>
        </div>
        <div class="seal-wrap" aria-hidden="true">
          <svg class="seal" viewBox="0 0 200 200">
            <defs><path id="seal-circle" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" /></defs>
            <text><textPath href="#seal-circle" textLength="512" lengthAdjust="spacing">ARIA STEAMEX · JOIN US · ARIA STEAMEX · JOIN US · </textPath></text>
          </svg>
          <span class="mark mark-aria-iso seal-iso"></span>
        </div>
      </div>
    </section>

    <section class="band band--lav on-stone">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap path">
        <div>
          <div class="big" aria-hidden="true">01</div>
          <span class="wide" style="color: var(--stone-ink-2)">Student</span>
          <h2 class="title">Join the team</h2>
        </div>
        <div>
          <p class="intro">If you are a student and want to learn robotics, leadership, technology, and compete in FIRST, this space is for you.</p>
          <ul class="checks">
            <li>No previous experience needed.</li>
            <li>Technical and personal training.</li>
            <li>A competitive and community-driven environment.</li>
          </ul>
          <div class="actions">
            <a href="https://forms.gle/hYeZ7WfwytA96drKA" target="_blank" rel="noopener noreferrer" class="btn-primary">Apply as a student</a>
            <a href="https://wa.me/525564876703" target="_blank" rel="noopener noreferrer" class="btn-secondary">Direct questions</a>
          </div>
        </div>
      </div>
      <span class="greca greca-bot" aria-hidden="true"></span>
    </section>

    <section class="band">
      
      <div class="wrap path">
        <div>
          <div class="big" aria-hidden="true">02</div>
          <span class="wide" style="color: var(--ink-2)">Mentor</span>
          <h2 class="title">Empower real talent</h2>
        </div>
        <div>
          <p class="intro">We are looking for people with professional, technical, or human experience who want to support young people in STEM.</p>
          <ul class="checks">
            <li>Engineering, business, or leadership.</li>
            <li>Direct impact on new generations.</li>
            <li>Flexible and meaningful participation.</li>
          </ul>
          <div class="actions">
            <a href="https://forms.gle/vGeAdjTnCT9TdxNa9" target="_blank" rel="noopener noreferrer" class="btn-primary">Apply as a mentor</a>
            <a href="mailto:ariasteamex@gmail.com" class="btn-secondary">Contact</a>
          </div>
        </div>
      </div>
      
    </section>

    <section class="band" style="padding-top: 0">
      <div class="wrap areas-sec">
        <div>
          <span class="wide" style="color: var(--ink-2)">Team areas</span>
          <h2 class="title">There is room for different talents</h2>
          <p class="sub">It is not all about building robots. A great team needs many strengths.</p>
        </div>
        <ul class="areas">
          <li><h3>Technical</h3><p>Mechanics, code, and electronics.</p></li>
          <li><h3>Creative</h3><p>Branding, media, and content.</p></li>
          <li><h3>Business</h3><p>Sponsors, organization, and strategy.</p></li>
          <li><h3>Human</h3><p>Leadership, mentorship, and impact.</p></li>
        </ul>
      </div>
    </section>

    <section class="band band--lav on-stone dc">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap">
        <span class="wide" style="color: var(--stone-ink-2)">Direct contact</span>
        <h2 class="title">Have questions?</h2>
        <p class="sub">Write to us and we will guide you personally.</p>
        <ul class="links">
          <li><a href="https://wa.me/525564876703" target="_blank" rel="noopener noreferrer">WhatsApp <span class="arrow" aria-hidden="true">→</span></a></li>
          <li><a href="mailto:ariasteamex@gmail.com">Email <span class="arrow" aria-hidden="true">→</span></a></li>
          <li><a href="https://instagram.com/aria.steamex" target="_blank" rel="noopener noreferrer">Instagram <span class="arrow" aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

  </main>

  <style>
  .pg { overflow: clip; }
  .hero { padding-block: var(--s-8) var(--s-9); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); align-items: end; }
  .hero h1 { font-size: var(--t-3xl); line-height: 1.02; max-width: 14ch; }
  .hero-solo h1 { max-width: 16ch; }
  .kicker { display: flex; align-items: center; gap: var(--s-4); color: var(--ink-2); margin-bottom: var(--s-5); }
  .kicker::before { content: ""; width: 48px; height: 1px; background: var(--accent-ink); }
  .lead { font-size: var(--t-lg); color: var(--ink-2); max-width: 52ch; margin-top: var(--s-5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .band { position: relative; padding-block: var(--s-9); }
  .band--lav { background: var(--stone); color: var(--stone-ink); }
  .band--lav p { color: var(--stone-ink-2); }
  .band--lav .greca { color: var(--brand); }
  .band--lav .greca-top { position: absolute; top: 0; left: 0; }
  .band--lav .greca-bot { position: absolute; bottom: 0; left: 0; }
  .band--lav.band { padding-block: calc(var(--s-9) + 14px); }
  .head { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 4fr); gap: var(--s-5); margin-bottom: var(--s-7); align-items: start; }
  .idx { font-family: var(--font-title); font-size: clamp(4rem, 10vw, 8.5rem); line-height: .8; color: var(--decor); }
  .band--lav .idx { color: var(--brand); }
  .head h2 { font-size: var(--t-2xl); max-width: 18ch; }
  .head .tag { display: block; margin-bottom: var(--s-3); color: var(--ink-2); }
  .band--lav .head .tag { color: var(--stone-ink-2); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .rows li { display: grid; grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-5); align-items: baseline; padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  .rows .n { font-family: var(--font-wide); font-size: .6875rem; letter-spacing: .14em; color: var(--accent-ink); transition: transform var(--dur) var(--ease); }
  .rows li:hover .n { transform: translateX(8px); }
  .rows h3 { font-family: var(--font-title); font-size: var(--t-xl); letter-spacing: 0; line-height: 1.1; }
  .rows p { color: var(--ink-2); }
  .band--lav .rows { border-color: rgba(0, 0, 0, .3); }
  .band--lav .rows li { border-color: rgba(0, 0, 0, .15); }
  .band--lav .rows .n { color: var(--brand); }
  .band--lav .rows p { color: var(--stone-ink-2); }
  .ph { width: 100%; aspect-ratio: 4 / 5; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mq { overflow: hidden; border-block: 1px solid var(--line-strong); padding-block: var(--s-4); }
  .mq-track { display: flex; width: max-content; animation: mq-slide 42s linear infinite; }
  .mq-copy { display: flex; flex-shrink: 0; }
  .mq-copy span { font-family: var(--font-title); font-size: var(--t-2xl); line-height: 1.1; white-space: nowrap; display: inline-flex; align-items: center; gap: var(--s-6); padding-right: var(--s-6); }
  .mq-copy span::after { content: ""; width: 12px; height: 12px; background: var(--accent-ink); transform: rotate(45deg); }
  @keyframes mq-slide { to { transform: translateX(-50%); } }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .head { grid-template-columns: 1fr; gap: var(--s-3); }
    .idx { font-size: 4rem; }
    .rows li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s-3) var(--s-4); }
    .rows li p { grid-column: 2; }
    .band { padding-block: var(--s-8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-track { width: auto; flex-wrap: wrap; }
    .mq-copy[aria-hidden="true"] { display: none; }
    .mq-copy { flex-wrap: wrap; }
  }

  .seal-wrap { position: relative; width: min(100%, 340px); aspect-ratio: 1; justify-self: end; color: var(--accent-ink); }
  .seal { position: absolute; inset: 0; width: 100%; height: 100%; animation: seal-spin 40s linear infinite; }
  .seal text { fill: currentColor; font-family: var(--font-wide); font-size: 10.5px; font-weight: 700; letter-spacing: .12em; }
  .seal-iso { position: absolute; left: 28%; right: 28%; top: 50%; transform: translateY(-50%); color: var(--accent); }
  @keyframes seal-spin { to { transform: rotate(360deg); } }
  .path { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s-8); align-items: start; }
  .path h2 { font-size: var(--t-3xl); line-height: 1; margin-top: var(--s-3); }
  .path .big { font-family: var(--font-title); font-size: clamp(5rem, 14vw, 11rem); line-height: .8; margin-bottom: var(--s-5); color: var(--decor); }
  .band--lav .path .big { color: var(--brand); }
  .path p.intro { font-size: var(--t-lg); margin-bottom: var(--s-6); }
  .checks { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .checks li { padding-block: var(--s-4); border-bottom: 1px solid var(--line); color: var(--ink-2); display: flex; gap: var(--s-4); align-items: baseline; }
  .checks li::before { content: ""; flex: 0 0 10px; height: 10px; background: var(--accent-ink); transform: rotate(45deg); }
  .band--lav .checks { border-color: rgba(0, 0, 0, .3); }
  .band--lav .checks li { border-color: rgba(0, 0, 0, .15); color: var(--stone-ink-2); }
  .band--lav .checks li::before { background: var(--brand); }
  .areas-sec { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--s-8); align-items: start; }
  .areas-sec h2 { font-size: var(--t-3xl); line-height: 1; margin: var(--s-3) 0 var(--s-5); }
  .areas-sec .sub { color: var(--ink-2); font-size: var(--t-lg); }
  .areas { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .areas li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-5); align-items: baseline; padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  .areas h3 { font-family: var(--font-title); font-size: var(--t-2xl); letter-spacing: 0; line-height: 1; }
  .areas p { color: var(--ink-2); }
  .dc h2 { font-size: var(--t-3xl); line-height: 1; margin: var(--s-3) 0 var(--s-3); }
  .dc p.sub { font-size: var(--t-lg); margin-bottom: var(--s-7); }
  .links { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(0, 0, 0, .3); }
  .links a { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding-block: var(--s-5); border-bottom: 1px solid rgba(0, 0, 0, .15); font-family: var(--font-title); font-size: var(--t-2xl); line-height: 1; color: var(--stone-ink); text-decoration: none; }
  .links .arrow { display: inline-block; transition: transform var(--dur) var(--ease); }
  .links a:hover .arrow { transform: translateX(14px); }
  @media (max-width: 960px) {
    .path, .areas-sec { grid-template-columns: 1fr; gap: var(--s-6); }
    .seal-wrap { justify-self: start; width: 220px; }
    .areas li { grid-template-columns: 1fr; gap: var(--s-1); }
  }
  @media (prefers-reduced-motion: reduce) { .links a:hover .arrow { transform: none; } }
</style>

</BaseLayout>
