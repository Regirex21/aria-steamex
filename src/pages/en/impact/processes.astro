---
import BaseLayout from "../../../layouts/baselayout.astro";

const docs = [
  {
    title: "PM - Kickoff and game analysis",
    description:
      "Game analysis process, idea generation, and initial planning.",
    image: "/assets/impacto/manual-taller.png",
    pdf: "/docs/EN-MDP-Kickoff-and-Game-Analysis.pdf",
  },

  {
    title: "PM - Modeling and CAD",
    description:
      "Modeling workflow, CAD design, and development of digital prototypes.",
    image: "/assets/impacto/buildseason.png",
    pdf: "/docs/EN-MDP-Modeling-and-CAD.pdf",
  },

  {
    title: "PM - Fabrication and assembly",
    description:
      "Manufacturing processes, assembly techniques, and shop organization.",
    image: "/assets/impacto/documentacion.png",
    pdf: "/docs/EN-MDP-Fabrication-and-Assembly.pdf",
  },

  {
    title: "PM - Programming and electronics",
    description:
      "Software development, systems integration, and testing processes.",
    image: "/assets/impacto/scouting.png",
    pdf: "/docs/EN-MDP-Programming-and-Electronics.pdf",
  },

  {
    title: "PM - Image and media",
    description:
      "Communication guidelines, social media, content, and management of the team's image.",
    image: "/assets/impacto/sponsors-doc.png",
    pdf: "/docs/Manual-Proceso-Imagen.pdf",
    label: "View in Spanish",
  },

  {
    title: "PM - Social impact",
    description:
      "Outreach methodology, STEM activities, and community impact projects.",
    image: "/assets/impacto/sostenibilidad.png",
    pdf: "/docs/Manual-Proceso-Impacto-Social.pdf",
    label: "View in Spanish",
  },
];
---

<BaseLayout title="Processes | ARIA STEAMEX" lang="en">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10 overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-60"></div>

      <div class="container-site py-24 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/40 mb-6">
          Impact / Processes
        </p>

        <h1 class="text-5xl md:text-7xl font-black mb-8">
          Process Manuals
        </h1>

        <p class="max-w-3xl text-lg text-white/65 leading-relaxed">
          Internal processes, workflows, operational documentation, and guidelines used within the team.
        </p>

      </div>

    </section>

    <!-- GRID -->
    <section class="container-site py-20">

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          docs.map((doc) =>
            doc.pending ? (
              <div class="border border-white/10 rounded-[28px] overflow-hidden bg-white/5 opacity-70 cursor-not-allowed">

                <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">
                  <img
                    src={doc.image}
                    alt={doc.title}
                    class="w-full h-full object-cover grayscale"
                  />
                </div>

                <div class="p-8 flex flex-col justify-between min-h-[240px]">
                  <div>
                    <h2 class="text-3xl font-black mb-4">{doc.title}</h2>
                    <p class="text-white/60 leading-relaxed">{doc.description}</p>
                  </div>
                  <div class="flex items-center justify-between mt-10">
                    <span class="text-white/50">Coming soon</span>
                  </div>
                </div>

              </div>
            ) : (
              <a
                href={doc.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-white/10 rounded-[28px] overflow-hidden bg-white/5 hover:bg-white/10 hover:border-white/20 transition duration-300"
              >

                <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">
                  <img
                    src={doc.image}
                    alt={doc.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                </div>

                <div class="p-8 flex flex-col justify-between min-h-[240px]">
                  <div>
                    <h2 class="text-3xl font-black mb-4">{doc.title}</h2>
                    <p class="text-white/60 leading-relaxed">{doc.description}</p>
                  </div>
                  <div class="flex items-center justify-between mt-10">
                    <span class="text-white/50 group-hover:text-white transition">
                      {doc.label ?? "View document"}
                    </span>
                    <span class="text-2xl group-hover:translate-x-2 transition duration-300">
                      →
                    </span>
                  </div>
                </div>

              </a>
            )
          )
        }

      </div>

    </section>

  </main>

</BaseLayout>
