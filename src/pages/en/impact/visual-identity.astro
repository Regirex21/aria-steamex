---
import BaseLayout from "../../../layouts/baselayout.astro";

const docs = [
  {
    title: "Brand Manual",
    description:
      "Visual guidelines, typography, colors, and correct use of the ARIA STEAMEX identity.",
    image: "/assets/impacto/identidad-visual.png",
    pdf: "/docs/Manual-de-Marca-ARIA-11040.pdf",
    label: "View in Spanish",
  },

  {
    title: "Official Logos",
    description:
      "Official logo versions, variations, and approved applications.",
    image: "/assets/impacto/brand-guidelines.png",
    pdf: "",
    pending: true,
  },

  {
    title: "Media Kit",
    description:
      "Graphic resources and institutional materials for sponsors and outreach.",
    image: "/assets/impacto/sponsors-doc.png",
    pdf: "",
    pending: true,
  },

  {
    title: "Social Media Identity",
    description:
      "Visual system for posts, digital content, and team communication.",
    image: "/assets/impacto/documentacion.png",
    pdf: "",
    pending: true,
  },

  {
    title: "Presentations",
    description:
      "Templates and guidelines for pitch decks and official presentations.",
    image: "/assets/impacto/business-plan.png",
    pdf: "",
    pending: true,
  },

  {
    title: "Visual Philosophy",
    description:
      "Visual concepts, inspiration, and creative direction of the ARIA identity.",
    image: "/assets/impacto/portada-ingenieria.png",
    pdf: "",
    pending: true,
  },
];
---

<BaseLayout title="Visual Identity | ARIA STEAMEX" lang="en">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10 overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-60"></div>

      <div class="container-site py-24 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/40 mb-6">
          Impact / Visual Identity
        </p>

        <h1 class="text-5xl md:text-7xl font-black mb-8">
          Visual Identity
        </h1>

        <p class="max-w-3xl text-lg text-white/65 leading-relaxed">
          Branding, graphic guidelines, and visual resources used by ARIA STEAMEX.
        </p>

      </div>

    </section>

    <!-- GRID -->
    <section class="container-site py-20">

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          docs.map((doc) =>
            doc.pending ? (
              <div class="border border-white/10 rounded-[28px] overflow-hidden bg-white/5 opacity-70 cursor-not-allowed">

                <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">
                  <img
                    src={doc.image}
                    alt={doc.title}
                    class="w-full h-full object-cover grayscale"
                  />
                </div>

                <div class="p-8 flex flex-col justify-between min-h-[240px]">
                  <div>
                    <h2 class="text-3xl font-black mb-4">{doc.title}</h2>
                    <p class="text-white/60 leading-relaxed">{doc.description}</p>
                  </div>
                  <div class="flex items-center justify-between mt-10">
                    <span class="text-white/50">Coming soon</span>
                  </div>
                </div>

              </div>
            ) : (
              <a
                href={doc.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-white/10 rounded-[28px] overflow-hidden bg-white/5 hover:bg-white/10 hover:border-white/20 transition duration-300"
              >

                <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">
                  <img
                    src={doc.image}
                    alt={doc.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                </div>

                <div class="p-8 flex flex-col justify-between min-h-[240px]">
                  <div>
                    <h2 class="text-3xl font-black mb-4">{doc.title}</h2>
                    <p class="text-white/60 leading-relaxed">{doc.description}</p>
                  </div>
                  <div class="flex items-center justify-between mt-10">
                    <span class="text-white/50 group-hover:text-white transition">
                      {doc.label ?? "View document"}
                    </span>
                    <span class="text-2xl group-hover:translate-x-2 transition duration-300">
                      →
                    </span>
                  </div>
                </div>

              </a>
            )
          )
        }

      </div>

    </section>

  </main>

</BaseLayout>
