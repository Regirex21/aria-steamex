---
import BaseLayout from "../../../layouts/baselayout.astro";

const whatsapp = "https://wa.me/523319751792";
const instagram = "https://www.instagram.com/aria.steamex/";

const contribute = [
  {
    title: "FIRST teams",
    desc: "Tell us about your team, your season, your robot, and your projects.",
  },
  {
    title: "Technical projects",
    desc: "Share designs, code, subsystems, or engineering solutions.",
  },
  {
    title: "Experiences",
    desc: "Stories from people in the STEM and robotics community.",
  },
];
---

<BaseLayout
  title="Olympus | ARIA STEAMEX Magazine"
  description="Olympus, the monthly magazine of the FIRST community in Mexico. Teams and people share their projects and experiences. Want to be featured? Contact us."
  lang="en">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10 overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-60"></div>

      <div class="container-site py-24 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/40 mb-6">
          Impact / Magazine
        </p>

        <h1 class="text-6xl md:text-8xl font-black mb-8">
          Olympus
        </h1>

        <p class="max-w-3xl text-lg text-white/70 leading-relaxed">
          A project in progress: the monthly magazine of the FIRST community in
          Mexico, where teams share who they are, their projects, and their
          experiences. We are preparing the first edition.
        </p>

      </div>

    </section>

    <!-- ABOUT -->
    <section class="container-site py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
            The project
          </p>
          <h2 class="text-4xl md:text-5xl font-black leading-tight">
            Made by the community, for the community
          </h2>
        </div>
        <div>
          <p class="text-white/72 text-lg leading-relaxed mb-6">
            Olympus brings together the work of FRC and FTC teams, spreads their
            projects, gives space to sponsors, and shares the stories of the
            people growing robotics in Mexico.
          </p>
          <p class="text-white/60 leading-relaxed">
            Every month we prepare a new edition with the content teams and
            collaborators share with us. If you want to be part of it, we would
            love to include you.
          </p>
        </div>
      </div>
    </section>

    <!-- WHAT YOU CAN CONTRIBUTE -->
    <section class="container-site pb-20">
      <div class="mb-12">
        <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
          What we share
        </p>
        <h2 class="text-4xl md:text-5xl font-black">What you can contribute</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {
          contribute.map((item) => (
            <div class="border border-white/10 bg-white/5 rounded-[28px] p-8">
              <h3 class="text-2xl font-black mb-4">{item.title}</h3>
              <p class="text-white/60 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="container-site pb-28">
      <div
        class="rounded-[32px] p-10 md:p-16 border border-white/10 text-center bg-gradient-to-r from-[#2c1f35] to-[#3d2b4a]"
      >
        <p class="text-sm uppercase tracking-[0.3em] text-white/45 mb-5">
          Get involved
        </p>
        <h2 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
          Want to be featured?
        </h2>
        <p class="text-white/70 max-w-2xl mx-auto mb-10 text-lg leading-relaxed">
          If your team or you want to share a project or an experience in
          Olympus, write to us and we will gladly include you in an upcoming edition.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Message us on WhatsApp
          </a>
          <a href={instagram} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Instagram
          </a>
        </div>
      </div>
    </section>

  </main>

</BaseLayout>
