---
import BaseLayout from "../../../layouts/baselayout.astro";

const categories = [
  {
    number: "01",
    title: "Process Manuals",
    description:
      "Workflows, safety, workshops, scouting, and the team's internal processes.",
    href: "/en/impact/processes",
  },

  {
    number: "02",
    title: "Engineering",
    description:
      "Robot architecture, programming, subsystems, and technical development.",
    href: "/en/impact/engineering",
  },

  {
    number: "03",
    title: "Business",
    description:
      "Strategy, sustainability, impact, and institutional documentation.",
    href: "/en/impact/business",
  },

  {
    number: "04",
    title: "CADs",
    description:
      "Mechanical designs, assemblies, renders, and CAD documentation.",
    href: "/en/impact/cads",
  },

  {
    number: "05",
    title: "Visual Identity",
    description:
      "Branding, graphic guidelines, media kit, and visual resources.",
    href: "/en/impact/visual-identity",
  },

];
---

<BaseLayout title="Impact | ARIA STEAMEX" lang="en">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-white/10">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-70"></div>

      <div class="container-site py-28 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/50 mb-6">
          ARIA STEAMEX
        </p>

        <h1 class="text-6xl md:text-8xl font-black uppercase leading-none mb-8">
          Impact
        </h1>

        <p class="max-w-2xl text-lg md:text-xl leading-relaxed text-white/70">
          A space where we document the engineering, processes,
          learning, and development within the team.
        </p>

      </div>

    </section>

    <!-- FEATURED -->
    <section class="container-site py-24">

      <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-10">
        Featured
      </p>

      <!-- OLYMPUS (main feature) -->
      <a
        href="/en/impact/magazine"
        class="group grid lg:grid-cols-2 rounded-[32px] border border-white/10 bg-white/5 overflow-hidden hover:border-white/25 transition duration-300"
      >

        <div class="order-2 lg:order-1 p-10 md:p-14 flex flex-col justify-center">

          <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
            Magazine · FIRST Community
          </p>

          <h2 class="text-5xl md:text-6xl font-black mb-6 leading-none">
            Olympus
          </h2>

          <p class="text-white/70 leading-relaxed mb-10 max-w-md">
            A monthly magazine made by and for the FIRST community in Mexico.
            Teams and people share their projects and experiences.
            We are preparing the first edition: want to be featured?
          </p>

          <span class="inline-flex items-center gap-3 self-start border border-white/20 px-6 py-4 rounded-full group-hover:bg-white group-hover:text-black transition duration-300">
            Discover Olympus
            <span class="group-hover:translate-x-1 transition">→</span>
          </span>

        </div>

        <div class="order-1 lg:order-2 relative min-h-[280px] lg:min-h-[460px] bg-[#2A0836] overflow-hidden">
          <img
            src="/assets/equipo/img-7434.jpg"
            alt="Olympus · STEAMEX Magazine"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <span class="absolute bottom-6 left-6 text-xs uppercase tracking-[0.3em] text-white/70">
            Issue 01 · Coming soon
          </span>
        </div>

      </a>

      <!-- FIRST AID (secondary feature) -->
      <a
        href="/docs/Manual-Primeros-Auxilios.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-6 grid md:grid-cols-3 rounded-[28px] border border-white/10 bg-white/5 overflow-hidden hover:border-white/25 transition duration-300"
      >

        <div class="md:col-span-2 p-8 md:p-10 flex flex-col justify-center">

          <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-3">
            Featured document
          </p>

          <h3 class="text-3xl md:text-4xl font-black mb-4">
            First aid manual
          </h3>

          <p class="text-white/65 leading-relaxed mb-6">
            An essential resource for team safety, with clear protocols
            for medical emergencies during workshops, events, and
            field activities.
          </p>

          <span class="inline-flex items-center gap-3 self-start text-white/60 group-hover:text-white transition">
            View in Spanish
            <span class="group-hover:translate-x-1 transition">→</span>
          </span>

        </div>

        <div class="relative min-h-[200px] bg-[#2A0836] overflow-hidden">
          <img
            src="/assets/impacto/primeros-auxilios.png"
            alt="First aid manual"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
        </div>

      </a>

    </section>

    <!-- CATEGORIES -->
    <section class="container-site pb-28">

      <div class="mb-16">

        <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
          Explore
        </p>

        <h2 class="text-4xl md:text-5xl font-black">
          Documentation areas
        </h2>

      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          categories.map((category) => (
            <a
              href={category.href}
              class="group border border-white/10 bg-white/5 rounded-[28px] p-8 hover:bg-white/10 hover:border-white/20 transition duration-300 min-h-[280px] flex flex-col justify-between"
            >
              <div>

                <p class="text-sm text-white/40 mb-10">
                  {category.number}
                </p>

                <h3 class="text-3xl font-black mb-6">
                  {category.title}
                </h3>

                <p class="text-white/60 leading-relaxed">
                  {category.description}
                </p>

              </div>

              <div class="flex items-center justify-between mt-12">

                <span class="text-white/50 group-hover:text-white transition">
                  Explore
                </span>

                <span class="text-2xl group-hover:translate-x-2 transition duration-300">
                  →
                </span>

              </div>

            </a>
          ))
        }

      </div>

    </section>

  </main>

</BaseLayout>
