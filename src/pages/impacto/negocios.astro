---
import BaseLayout from "../../layouts/baselayout.astro";

const docs = [
  {
    title: "Plan de Negocios 2026",
    description:
      "Estrategia, sostenibilidad, crecimiento e impacto del equipo.",
    image: "/assets/business-plan.png",
    pdf: "/impacto/pdfs/business-plan-2026.pdf",
  },

  {
    title: "Patrocinios",
    description:
      "Estructura de patrocinio, beneficios y relación con aliados.",
    image: "/assets/sponsors-doc.png",
    pdf: "/impacto/pdfs/patrocinios.pdf",
  },

  {
    title: "Impacto Comunitario",
    description:
      "Actividades STEM, outreach y proyectos desarrollados por el equipo.",
    image: "/assets/outreach.png",
    pdf: "/impacto/pdfs/impacto-comunitario.pdf",
  },

  {
    title: "Sostenibilidad",
    description:
      "Planeación financiera, continuidad y crecimiento a largo plazo.",
    image: "/assets/sostenibilidad.png",
    pdf: "/impacto/pdfs/sostenibilidad.pdf",
  },

  {
    title: "Estrategia de Crecimiento",
    description:
      "Objetivos, expansión y visión futura de ARIA STEAMEX.",
    image: "/assets/estrategia.png",
    pdf: "/impacto/pdfs/estrategia.pdf",
  },

  {
    title: "Pitch Deck",
    description:
      "Presentación institucional del equipo y su propuesta de valor.",
    image: "/assets/pitchdeck.png",
    pdf: "/impacto/pdfs/pitchdeck.pdf",
  },
];
---

<BaseLayout title="Negocios | ARIA STEAMEX">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10 overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-60"></div>

      <div class="container-site py-24 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/40 mb-6">
          Impacto / Negocios
        </p>

        <h1 class="text-5xl md:text-7xl font-black mb-8">
          Negocios e impact
        </h1>

        <p class="max-w-3xl text-lg text-white/65 leading-relaxed">
          Estrategia, sostenibilidad, impacto y documentación
          institucional desarrollada por el equipo.
        </p>

      </div>

    </section>

    <!-- GRID -->
    <section class="container-site py-20">

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          docs.map((doc) => (
            <a
              href={doc.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="group border border-white/10 rounded-[28px] overflow-hidden bg-white/5 hover:bg-white/10 hover:border-white/20 transition duration-300"
            >

              <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">

                <img
                  src={doc.image}
                  alt={doc.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />

              </div>

              <div class="p-8 flex flex-col justify-between min-h-[240px]">

                <div>

                  <h2 class="text-3xl font-black mb-4">
                    {doc.title}
                  </h2>

                  <p class="text-white/60 leading-relaxed">
                    {doc.description}
                  </p>

                </div>

                <div class="flex items-center justify-between mt-10">

                  <span class="text-white/50 group-hover:text-white transition">
                    Ver documento
                  </span>

                  <span class="text-2xl group-hover:translate-x-2 transition duration-300">
                    →
                  </span>

                </div>

              </div>

            </a>
          ))
        }

      </div>

    </section>

  </main>

</BaseLayout>