---
import BaseLayout from "../../layouts/baselayout.astro";

const categories = [
  {
    number: "01",
    title: "Manuales de Proceso",
    description:
      "Workflows, seguridad, talleres, scouting y procesos internos del equipo.",
    href: "/impacto/procesos",
  },

  {
    number: "02",
    title: "Ingeniería",
    description:
      "Arquitectura del robot, programación, subsistemas y desarrollo técnico.",
    href: "/impacto/ingenieria",
  },

  {
    number: "03",
    title: "Negocios",
    description:
      "Estrategia, sostenibilidad, impacto y documentación institucional.",
    href: "/impacto/negocios",
  },

  {
    number: "04",
    title: "CADs",
    description:
      "Diseños mecánicos, ensamblajes, renders y documentación CAD.",
    href: "/impacto/cads",
  },

  {
    number: "05",
    title: "Identidad Visual",
    description:
      "Branding, lineamientos gráficos, media kit y recursos visuales.",
    href: "/impacto/branding",
  },

];
---

<BaseLayout title="Impacto | ARIA STEAMEX">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative overflow-hidden border-b border-white/10">
      
      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-70"></div>

      <div class="container-site py-28 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/50 mb-6">
          ARIA STEAMEX
        </p>

        <h1
          class="text-6xl md:text-8xl font-black uppercase leading-none mb-8"
        >
          Impacto
        </h1>

        <p
          class="max-w-2xl text-lg md:text-xl leading-relaxed text-white/70"
        >
          Un espacio donde documentamos ingeniería, procesos,
          aprendizaje y desarrollo dentro del equipo.
        </p>

        <div class="mt-16 flex flex-wrap gap-12">

          <div>
            <p class="text-4xl font-bold">50+</p>
            <p class="text-white/50 mt-2">Páginas documentadas</p>
          </div>

          <div>
            <p class="text-4xl font-bold">6</p>
            <p class="text-white/50 mt-2">Áreas organizadas</p>
          </div>

          <div>
            <p class="text-4xl font-bold">2026</p>
            <p class="text-white/50 mt-2">Temporada activa</p>
          </div>

        </div>

      </div>

    </section>

    <!-- DOCUMENTO DESTACADO -->
    <section class="container-site py-24">

      <div
        class="grid lg:grid-cols-2 gap-12 items-center border border-white/10 rounded-[32px] bg-white/5 backdrop-blur-md overflow-hidden"
      >

        <div class="p-10 md:p-14">

          <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
            Documento destacado
          </p>

          <h2 class="text-4xl md:text-5xl font-black mb-6">
            Manual de primeros auxilios
          </h2>

          <p class="text-white/70 leading-relaxed mb-10">
            Un recurso esencial para la seguridad del equipo, con protocolos
            claros para emergencias médicas durante talleres, eventos y
            actividades de campo.
          </p>

          <a
            href="/impacto/ingenieria"
            class="inline-flex items-center gap-3 border border-white/20 px-6 py-4 rounded-full hover:bg-white hover:text-black transition duration-300"
          >
            Explorar documentación
            <span>→</span>
          </a>

        </div>

       <div class="h-full min-h-[420px] bg-[#2A0836] overflow-hidden">

  <img
    src="/assets/portada-ingenieria.png"
    alt="Libro de Ingeniería"
    class="w-full h-full object-cover"
  />

</div>

      </div>

    </section>

    <!-- CATEGORÍAS -->
    <section class="container-site pb-28">

      <div class="mb-16">

        <p class="text-sm uppercase tracking-[0.3em] text-white/40 mb-4">
          Explorar
        </p>

        <h2 class="text-4xl md:text-5xl font-black">
          Áreas de documentación
        </h2>

      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          categories.map((category) => (
            <a
              href={category.href}
              class="group border border-white/10 bg-white/5 rounded-[28px] p-8 hover:bg-white/10 hover:border-white/20 transition duration-300 min-h-[280px] flex flex-col justify-between"
            >
              <div>

                <p class="text-sm text-white/40 mb-10">
                  {category.number}
                </p>

                <h3 class="text-3xl font-black mb-6">
                  {category.title}
                </h3>

                <p class="text-white/60 leading-relaxed">
                  {category.description}
                </p>

              </div>

              <div class="flex items-center justify-between mt-12">

                <span class="text-white/50 group-hover:text-white transition">
                  Explorar
                </span>

                <span
                  class="text-2xl group-hover:translate-x-2 transition duration-300"
                >
                  →
                </span>

              </div>

            </a>
          ))
        }

      </div>

    </section>

  </main>

</BaseLayout>