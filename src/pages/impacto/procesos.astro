---
import BaseLayout from "../../layouts/baselayout.astro";

const docs = [
  {
    title: "MDP - kickoff y análisis del reto",
    description:
      "Proceso de análisis del reto, generación de ideas y planificación inicial.",
    image: "/assets/manual-taller.png",
    pdf: "/docs/MDP-Kickoff-y-Análisis-del-Reto.pdf",
  },

  {
    title: "MDP - modelado y CAD",
    description:
      "Workflow de modelado, diseño CAD y desarrollo de prototipos digitales.",
    image: "/assets/buildseason.png",
    pdf: "/docs/MDP-Modelado-y-CAD.pdf",
  },

  {
    title: "MDP - fabricación y ensamblaje",
    description:
      "Procesos de manufactura, técnicas de ensamblaje y organización del taller.",
    image: "/assets/documentacion.png",
    pdf: "/docs/MDP-Fabricación-y-Ensamblaje.pdf",
  },

  {
    title: "MDP - programación y electrónica",
    description:
      "Desarrollo de software, integración de sistemas y procesos de testing.",
    image: "/assets/scouting.png",
    pdf: "/docs/MDP-Programación-y-Electrónica.pdf",
  },
];
---

<BaseLayout title="Procesos | ARIA STEAMEX">

  <main class="min-h-screen bg-[#140019] text-white">

    <!-- HERO -->
    <section class="relative border-b border-white/10 overflow-hidden">

      <div class="absolute inset-0 bg-gradient-to-b from-[#2A0836] to-transparent opacity-60"></div>

      <div class="container-site py-24 relative z-10">

        <p class="text-sm tracking-[0.3em] uppercase text-white/40 mb-6">
          Impacto / Procesos
        </p>

        <h1 class="text-5xl md:text-7xl font-black mb-8">
          Manuales de Proceso
        </h1>

        <p class="max-w-3xl text-lg text-white/65 leading-relaxed">
          Procesos internos, workflows, documentación operativa
          y lineamientos utilizados dentro del equipo.
        </p>

      </div>

    </section>

    <!-- GRID -->
    <section class="container-site py-20">

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

        {
          docs.map((doc) => (
            <a
              href={doc.pdf}
              target="_blank"
              class="group border border-white/10 rounded-[28px] overflow-hidden bg-white/5 hover:bg-white/10 hover:border-white/20 transition duration-300"
            >

              <div class="aspect-[4/3] overflow-hidden bg-[#2A0836]">

                <img
                  src={doc.image}
                  alt={doc.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />

              </div>

              <div class="p-8 flex flex-col justify-between min-h-[240px]">

                <div>

                  <h2 class="text-3xl font-black mb-4">
                    {doc.title}
                  </h2>

                  <p class="text-white/60 leading-relaxed">
                    {doc.description}
                  </p>

                </div>

                <div class="flex items-center justify-between mt-10">

                  <span class="text-white/50 group-hover:text-white transition">
                    Ver documento
                  </span>

                  <span class="text-2xl group-hover:translate-x-2 transition duration-300">
                    →
                  </span>

                </div>

              </div>

            </a>
          ))
        }

      </div>

    </section>

  </main>

</BaseLayout>