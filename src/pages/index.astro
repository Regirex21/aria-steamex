---
import BaseLayout from "../layouts/baselayout.astro";
import AriaHero from "../components/aria-hero.astro";

const marquee = ["FRC 11040", "ARTEMIS", "REBUILT", "Fundadas en 2025", "Ciudad de México", "Acceso 100% gratuito", "Olympus"];
const rows = [
  { n: "01", t: "Nosotras", d: "Conoce nuestra misión, visión, historia y liderazgo dentro de Project Steamex.", href: "/nosotras" },
  { n: "02", t: "FIRST / FRC", d: "Descubre la competencia de robótica juvenil más prestigiosa del mundo.", href: "/first" },
  { n: "03", t: "Documentación pública", d: "Nuestro aporte a la comunidad y al desarrollo de talento femenil en STEM, abierto para otros equipos.", href: "/impacto" },
  { n: "04", t: "Únete", d: "Reclutamiento por formulario, informe introductorio o invitación.", href: "/unirse" },
];
const facts = [
  ["Número de equipo", "11040"],
  ["Programa", "FIRST Robotics Competition"],
  ["Año de fundación", "2025"],
  ["Base comunitaria", "Ciudad de México"],
  ["Acceso", "100% gratuito"],
  ["Robot 2026", "ARTEMIS, REBUILT"],
];
const sponsors = [
  { src: "/assets/sponsors/gene-haas.jpg", alt: "Gene Haas Foundation" },
  { src: "/assets/sponsors/intuitive.jpg", alt: "Intuitive Foundation" },
  { src: "/assets/sponsors/boeing.jpg", alt: "Boeing" },
  { src: "/assets/sponsors/solveurs-travel.png", alt: "Solveurs Travel" },
];
---

<BaseLayout title="ARIA STEAMEX | Oficial">
  <main>
    <AriaHero lang="es" joinHref="/unirse" moreHref="#artemis" />

    <div class="hm-marq" aria-hidden="true">
      <div class="hm-marq-track">
        <ul>{marquee.map((m) => <li class="wide">{m}</li>)}</ul>
        <ul>{marquee.map((m) => <li class="wide">{m}</li>)}</ul>
      </div>
    </div>

    <section id="artemis" class="section on-stone" aria-labelledby="about-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-index">01 / Crecimiento</p>
          <h2 id="about-title" class="title">Ingeniería con propósito</h2>
        </div>
        <div class="hm-about">
          <div>
            <p class="hm-statement">
              ARIA STEAMEX no solo compite. Forma líderes, desarrolla talento técnico y abre oportunidades reales para mujeres en STEM.
            </p>
            <dl class="hm-facts">
              {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
            </dl>
            <a class="btn" href="/nosotras">Conoce al equipo <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </div>
          <div class="hm-photos">
            <div class="photo-corner hm-ph1"><img src="/assets/equipo/img-7434.jpg" alt="Integrantes de ARIA STEAMEX" loading="lazy" /></div>
            <div class="photo-corner photo-corner--alt hm-ph2"><img src="/assets/equipo/img-7248.jpg" alt="Equipo ARIA STEAMEX en actividad" loading="lazy" /></div>
          </div>
        </div>
      </div>
    </section>

    <div class="greca" aria-hidden="true"></div>

    <section class="section" aria-labelledby="paths-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-index">02 / Explora</p>
          <h2 id="paths-title" class="title">Dónde empezar</h2>
        </div>
        <ol class="hm-rows">
          {rows.map((r) => (
            <li>
              <a href={r.href}>
                <span class="hm-n wide">{r.n}</span>
                <span class="hm-t title">{r.t}</span>
                <span class="hm-d">{r.d}</span>
                <span class="hm-go" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section on-stone hm-spons" aria-labelledby="spons-title">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-index">03 / Aliados</p>
          <h2 id="spons-title" class="title">Con el apoyo de</h2>
        </div>
        <ul class="hm-logos">
          {sponsors.map((s) => <li><img src={s.src} alt={s.alt} loading="lazy" /></li>)}
        </ul>
        <a class="btn" href="/sponsors">Ver patrocinadores <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <section id="unirse" class="section hm-join" aria-labelledby="join-title">
      <div class="hm-join-mark mark mark-aria-iso" aria-hidden="true"></div>
      <div class="wrap">
        <div class="glass-panel hm-join-card">
          <p class="wide hm-eyebrow">Próximo paso</p>
          <h2 id="join-title" class="title">Construyamos algo grande</h2>
          <p>Si quieres unirte, colaborar, apoyar o conocer más sobre ARIA STEAMEX, este es el momento.</p>
          <div class="hm-actions">
            <a class="btn" href="/contacto">Contactar <span class="arrow" aria-hidden="true">&rarr;</span></a>
            <a class="btn btn--line" href="/unirse">Unirse</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hm-marq { overflow: hidden; border-block: 1px solid var(--line); background: var(--bg-2); padding-block: var(--s-4); }
  .hm-marq-track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .hm-marq ul { display: flex; margin: 0; padding: 0; list-style: none; }
  .hm-marq li { white-space: nowrap; padding-inline: var(--s-6); color: var(--accent-ink); display: flex; align-items: center; gap: var(--s-6); }
  .hm-marq li::after { content: ""; width: 6px; height: 6px; background: var(--decor); transform: rotate(45deg); }

  .hm-about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  .hm-statement { font-family: var(--font-serif); font-size: var(--t-xl); line-height: 1.25; color: var(--stone-ink); max-width: 28ch; margin-bottom: var(--s-6); }
  .hm-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--s-5); margin: 0 0 var(--s-6); }
  .hm-facts dt { font-family: var(--font-wide); font-size: .625rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--stone-ink-2); padding-top: var(--s-3); border-top: 1px solid rgba(0,0,0,.2); }
  .hm-facts dd { margin: 0 0 var(--s-4); font-size: var(--t-lg); font-weight: 500; color: var(--stone-ink); }
  .hm-photos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); align-items: end; }
  .hm-photos img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hm-ph1 { aspect-ratio: 3 / 4; }
  .hm-ph2 { aspect-ratio: 3 / 3.4; }

  .hm-rows { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line-strong); }
  .hm-rows a { display: grid; grid-template-columns: 4rem minmax(0, 1.2fr) minmax(0, 1.5fr) 2rem; gap: var(--s-5); align-items: center; padding-block: var(--s-6); border-top: 1px solid var(--line-strong); text-decoration: none; color: var(--ink); }
  .hm-t { font-size: var(--t-2xl); }
  .hm-n { color: var(--accent-ink); }
  .hm-d { color: var(--ink-2); }
  .hm-go { justify-self: end; font-size: 1.6rem; color: var(--accent-ink); transition: transform var(--dur) var(--ease); }
  .hm-rows a:hover .hm-go { transform: translateX(8px); }

  .hm-logos { list-style: none; margin: 0 0 var(--s-6); padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
  .hm-logos li { background: #fff; border-radius: 16px; display: grid; place-items: center; padding: var(--s-5); min-height: 110px; }
  .hm-logos img { max-width: 100%; max-height: 64px; object-fit: contain; }

  .hm-join { overflow: hidden; }
  .hm-join-mark { position: absolute; right: -6%; top: 50%; width: min(60vw, 640px); color: var(--decor); opacity: .45; transform: translateY(-50%) rotate(-8deg); }
  .hm-join-card { position: relative; padding: clamp(28px, 5vw, 64px); max-width: 760px; }
  .hm-join-card h2 { font-size: var(--t-2xl); margin-block: var(--s-3) var(--s-4); }
  .hm-join-card p { color: var(--ink-2); font-size: var(--t-lg); max-width: 52ch; }
  .hm-eyebrow { color: var(--accent-ink); }
  .hm-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  @media (max-width: 860px) {
    .hm-about { grid-template-columns: 1fr; gap: var(--s-6); }
    .hm-rows a { grid-template-columns: 2.5rem 1fr 1.5rem; gap: var(--s-3); }
    .hm-d { grid-column: 2 / 3; }
    .hm-go { grid-row: 1; grid-column: 3; }
    .hm-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
