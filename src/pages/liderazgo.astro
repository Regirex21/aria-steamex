---
// src/pages/liderazgo.astro

import BaseLayout from "../layouts/baselayout.astro";

 const coaches = [
  {
    role: "Director Nacional · Project STEAMEX",
    name: "Abraham Martínez",
    description:
      "Dirige la visión institucional de Project STEAMEX y apoya el crecimiento estratégico de iniciativas STEM de alto impacto.",
    image: "/assets/Mentoras/abraham.png",
  },

  {
    role: "Head Coach",
    name: "Regina Servín",
    description:
      "Lidera las áreas técnicas del equipo incluyendo mecánica, programación y documentación. Supervisa procesos de desarrollo, estrategia competitiva y formación técnica interna.",
    image: "/assets/Mentoras/rex.png",
  },

  {
    role: "Coach",
    name: "Isis Reyes ",
    description:
      "Encargada de patrocinio, impacto e imagen del equipo. Coordina alianzas, outreach, branding y estrategias de comunicación institucional.",
    image: "/assets/Mentoras/mei.jpeg",
  },
];

const mentors = [
  {
    name: "Gemma Navarrete",
    area: "Impacto",
    description: "Outreach y comunidad.",
    image: "/assets/Mentoras/gemma.jpeg",
  },

  {
    name: "Paulina Peña",
    area: "Impacto",
    description: "Outreach y comunidad.",
    image: "/assets/Mentoras/pau.png",
  },

  {
    name: "Britany Valadez",
    area: "Mecánica y Programación",
    description: "Formación y desarrollo de contenidos técnicos.",
    image: "/assets/Mentoras/bri.jpeg",
  },

  {
    name: "Renata Servín",
    area: "Mecánica",
    description: "Diseño, ensamble y manufactura.",
    image: "/assets/Mentoras/renata.jpeg",
  },

  {
    name: "Katheryn Azano",
    area: "Programación",
    description: "Desarrollo de software y automatización.",
    image: "/assets/Mentoras/katy.png",
  },
];
---



<BaseLayout title="Liderazgo | ARIA STEAMEX">


  <main class="overflow-hidden">

    <!-- HERO -->
    <section class="container-site pt-28 pb-24 text-center relative overflow-hidden">

      <div class="glow-orb w-56 h-56 bg-purple-400/20 top-10 right-20"></div>
      <div class="glow-orb w-40 h-40 bg-pink-300/10 bottom-0 left-10"></div>

      <p class="text-sm uppercase tracking-[0.25em] text-white/45 mb-6 reveal show">
        Conoce al liderazgo
      </p>

      <h1 class="text-6xl md:text-8xl max-w-5xl mx-auto leading-none mb-8 reveal show">
        Personas que construyen oportunidades
      </h1>

      <p class="text-xl text-white/70 max-w-3xl mx-auto leading-relaxed reveal show">
        ARIA STEAMEX crece gracias a coaches, mentoras y aliados comprometidos
        con formar una nueva generación de mujeres líderes en STEM.
      </p>

    </section>

    <!-- LEADERSHIP INTRO -->
    <section class="container-site pb-24 reveal">

      <div class="rounded-3xl p-10 md:p-14 bg-gradient-to-r from-[#2c1f35] to-[#3d2b4a] border border-white/10">

        <p class="text-sm uppercase tracking-[0.25em] text-white/45 mb-5">
          Nuestra filosofía
        </p>

        <h2 class="text-5xl md:text-6xl leading-none mb-8 max-w-5xl">
          Liderar es servir, enseñar y elevar estándares.
        </h2>

        <p class="text-white/72 text-lg max-w-3xl leading-relaxed">
          No buscamos figuras decorativas. Buscamos liderazgo activo:
          personas que enseñan, acompañan, exigen excelencia y abren camino.
        </p>

      </div>

    </section>

<!-- COACHES -->
<section class="container-site pb-28">

  <div class="mb-10 reveal">
    <p class="text-sm uppercase tracking-[0.25em] text-white/45 mb-4">
      Coaches
    </p>

<h2 class="text-5xl leading-none">
  Dirección & liderazgo institucional
</h2>
  </div>

  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

    {
      coaches.map((coach, index) => (
        <div class={`glass rounded-3xl p-8 reveal delay-${index}`}>
          
          <div class="w-full h-[320px] rounded-2xl border border-white/10 mb-6 overflow-hidden">
            <img
              src={coach.image}
              alt={coach.name}
              class="w-full h-full max-h-full max-w-full object-cover"
            />
          </div>

          <p class="text-sm uppercase tracking-[0.2em] text-white/45 mb-3">
            {coach.role}
          </p>

          <h3 class="text-4xl mb-4">
            {coach.name}
          </h3>

          <p class="text-white/65 leading-relaxed">
            {coach.description}
          </p>

        </div>
      ))
    }

  </div>

</section>

<!-- LEADERSHIP TEAM -->
<section class="container-site pb-28">

  <div class="mb-10 reveal">
    <p class="text-sm uppercase tracking-[0.25em] text-white/45 mb-4">
      Mentoras & Mentores
    </p>

    <h2 class="text-5xl leading-none">
      Personas que impulsan áreas clave
    </h2>
  </div>

  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

  {
    mentors.map((mentor, index) => (
      <div class="glass rounded-3xl p-6 reveal">

        <div class="w-full h-[260px] rounded-2xl border border-white/10 mb-6 overflow-hidden">
          <img
            src={mentor.image}
            alt={mentor.name}
            class="w-full h-full max-h-full max-w-full object-cover"
          />
        </div>

        <div class="text-center">

          <p class="text-xs uppercase tracking-[0.22em] text-white/45 mb-3">
            {mentor.area}
          </p>

          <h3 class="text-2xl mb-3 leading-none">
            {mentor.name}
          </h3>

          <p class="text-white/65 text-sm leading-relaxed">
            {mentor.description}
          </p>

        </div>

      </div>
    ))
  }

</div>

</section>


    <!-- CTA -->
    <section class="container-site pb-32 reveal">

      <div class="rounded-3xl p-10 md:p-14 bg-gradient-to-r from-[#2c1f35] to-[#3d2b4a] border border-white/10">

        <p class="text-sm uppercase tracking-[0.25em] text-white/45 mb-4 reveal delay-1">
          Próximo paso
        </p>

        <h2 class="text-5xl md:text-6xl mb-6 leading-none reveal delay-2">
          ¿Quieres apoyar esta misión?
        </h2>

        <p class="text-white/70 max-w-2xl mb-8 text-lg reveal delay-3">
          Buscamos nuevas mentoras, aliados y personas listas para construir futuro.
        </p>

        <div class="flex flex-wrap gap-4 reveal delay-4">

          <a href="/unirse" class="btn-primary">
            Aplicar como mentor(a)
          </a>

          <a href="/contacto" class="btn-secondary">
            Contactar
          </a>

        </div>

      </div>

    </section>

  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const items = document.querySelectorAll(".reveal");

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("show");
          }
        });
      }, { threshold: 0.15 });

      items.forEach((item) => observer.observe(item));
    });
  </script>

 

</BaseLayout>