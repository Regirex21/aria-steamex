---
// src/pages/first.astro
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout
  title="FIRST y FRC: qué es y cómo lo vivimos | ARIA STEAMEX"
  description="Qué es FIRST Robotics Competition y cómo lo vive ARIA STEAMEX: ingeniería, estrategia, negocios y trabajo en equipo para estudiantes."
>

  <main class="pg">

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker wide">FIRST Robotics Competition</p>
          <h1 class="title">Mucho más que robots</h1>
          <p class="lead">FIRST combina ingeniería, estrategia, negocios y trabajo en equipo en una de las experiencias estudiantiles más prestigiosas del mundo.</p>
        </div>
        <div class="photo-corner photo-corner--alt ph ph--wide">
          <img src="/assets/equipo/img-7248.jpg" alt="Integrantes del equipo ARIA STEAMEX trabajando" loading="eager" />
        </div>
      </div>
    </section>

    <div class="mq"><div class="mq-track"><div class="mq-copy"><span>Comunidad global</span><span>Educación STEAM aplicada</span><span>Liderazgo juvenil</span><span>FRC de nivel élite</span><span>Comunidad global</span><span>Educación STEAM aplicada</span><span>Liderazgo juvenil</span><span>FRC de nivel élite</span></div><div class="mq-copy" aria-hidden="true"><span>Comunidad global</span><span>Educación STEAM aplicada</span><span>Liderazgo juvenil</span><span>FRC de nivel élite</span><span>Comunidad global</span><span>Educación STEAM aplicada</span><span>Liderazgo juvenil</span><span>FRC de nivel élite</span></div></div></div>

    <section class="band">
      <div class="wrap">
        <div class="head">
          <div class="idx" aria-hidden="true">01</div>
          <div>
            <span class="tag wide">Qué es FIRST</span>
            <h2 class="title">Una plataforma para crecer</h2>
          </div>
        </div>
        <p class="big-words">Mecánica, programación, electrónica, negocios, liderazgo, operaciones, imagen e impacto: en FIRST cabe cada talento.</p>
        <dl class="defs">
          <div><dt>Mecánica</dt><dd>Diseño, ensamblaje y sistemas físicos del robot.</dd></div>
          <div><dt>Programación</dt><dd>Código, sensores, automatización y control.</dd></div>
          <div><dt>Electrónica</dt><dd>Cableado, energía e integración de sistemas eléctricos.</dd></div>
          <div><dt>Negocios</dt><dd>Patrocinios, presupuesto y estrategia financiera.</dd></div>
          <div><dt>Liderazgo</dt><dd>Organización, comunicación y dirección del equipo.</dd></div>
          <div><dt>Operaciones</dt><dd>Planeación, logística y coordinación general.</dd></div>
          <div><dt>Imagen</dt><dd>Identidad de marca, redes sociales, contenido y presencia pública.</dd></div>
          <div><dt>Impacto</dt><dd>Difusión, comunidad y promoción de STEM.</dd></div>
        </dl>
      </div>
    </section>

    <section class="band band--lav on-stone">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap frc">
        <div>
          <span class="wide" style="color: var(--stone-ink-2)">Qué es FRC</span>
          <h2 class="title" style="margin-top: var(--s-4)">La experiencia estudiantil más intensa en robótica</h2>
        </div>
        <div>
          <p>FIRST Robotics Competition reta a estudiantes a diseñar, fabricar y programar robots de alto rendimiento para competir cada año en un nuevo juego oficial junto a miles de equipos del mundo.</p>
          <div class="actions">
            <a href="https://www.firstinspires.org" target="_blank" rel="noopener noreferrer" class="btn-primary">Sitio oficial de FIRST</a>
            <a href="/unirse" class="btn-secondary">Vivirlo con ARIA</a>
          </div>
        </div>
      </div>
      <div class="wrap">
        <dl class="stats">
          <div><dt>6+</dt><dd>Semanas de construcción</dd></div>
          <div><dt>1</dt><dd>Juego nuevo cada año</dd></div>
          <div><dt>Global</dt><dd>Comunidad internacional</dd></div>
          <div><dt>Real</dt><dd>Ingeniería aplicada</dd></div>
        </dl>
      </div>
      <span class="greca greca-bot" aria-hidden="true"></span>
    </section>

    <section class="band">
      <div class="wrap learn">
        <div>
          <div class="photo-corner ph">
            <img src="/assets/equipo/img-7434.jpg" alt="Integrantes del equipo ARIA STEAMEX trabajando" loading="lazy" decoding="async" />
          </div>
        </div>
        <div>
          <div class="head" style="grid-template-columns: 1fr; margin-bottom: var(--s-6)">
            <div>
              <span class="tag wide">Lo que aprendes</span>
              <h2 class="title">Mucho más que competir</h2>
            </div>
          </div>
          <ol class="rows">
            <li><span class="n">01</span><h3>CAD</h3><p>Diseño mecánico profesional.</p></li>
            <li><span class="n">02</span><h3>Manufactura</h3><p>Procesos reales y fabricación.</p></li>
            <li><span class="n">03</span><h3>Programación</h3><p>Software para sistemas físicos.</p></li>
            <li><span class="n">04</span><h3>Mercadotecnia</h3><p>Marca, redes y narrativa.</p></li>
            <li><span class="n">05</span><h3>Negocios</h3><p>Relación con aliados y patrocinadores.</p></li>
            <li><span class="n">06</span><h3>Liderazgo</h3><p>Organización y toma de decisiones.</p></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="band band--lav on-stone">
      <span class="greca greca-top" aria-hidden="true"></span>
      <div class="wrap final">
        <div>
          <h2 class="title">¿Quieres vivirlo con ARIA?</h2>
          <p>Únete a una nueva generación de estudiantes que compiten, aprenden y construyen algo grande.</p>
        </div>
        <div class="actions" style="margin-top: 0">
          <a href="/unirse" class="btn-primary">Aplicar</a>
          <a href="/contacto" class="btn-secondary">Contactar</a>
        </div>
      </div>
    </section>

  </main>

  <style>
  .pg { overflow: clip; }
  .hero { padding-block: var(--s-8) var(--s-9); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-7); align-items: end; }
  .hero h1 { font-size: var(--t-3xl); line-height: 1.02; max-width: 14ch; }
  .hero-solo h1 { max-width: 16ch; }
  .kicker { display: flex; align-items: center; gap: var(--s-4); color: var(--ink-2); margin-bottom: var(--s-5); }
  .kicker::before { content: ""; width: 48px; height: 1px; background: var(--accent-ink); }
  .lead { font-size: var(--t-lg); color: var(--ink-2); max-width: 52ch; margin-top: var(--s-5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .band { position: relative; padding-block: var(--s-9); }
  .band--lav { background: var(--stone); color: var(--stone-ink); }
  .band--lav p { color: var(--stone-ink-2); }
  .band--lav .greca { color: var(--brand); }
  .band--lav .greca-top { position: absolute; top: 0; left: 0; }
  .band--lav .greca-bot { position: absolute; bottom: 0; left: 0; }
  .band--lav.band { padding-block: calc(var(--s-9) + 14px); }
  .head { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 4fr); gap: var(--s-5); margin-bottom: var(--s-7); align-items: start; }
  .idx { font-family: var(--font-title); font-size: clamp(4rem, 10vw, 8.5rem); line-height: .8; color: var(--decor); }
  .band--lav .idx { color: var(--brand); }
  .head h2 { font-size: var(--t-2xl); max-width: 18ch; }
  .head .tag { display: block; margin-bottom: var(--s-3); color: var(--ink-2); }
  .band--lav .head .tag { color: var(--stone-ink-2); }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .rows li { display: grid; grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-5); align-items: baseline; padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  .rows .n { font-family: var(--font-wide); font-size: .6875rem; letter-spacing: .14em; color: var(--accent-ink); transition: transform var(--dur) var(--ease); }
  .rows li:hover .n { transform: translateX(8px); }
  .rows h3 { font-family: var(--font-title); font-size: var(--t-xl); letter-spacing: 0; line-height: 1.1; }
  .rows p { color: var(--ink-2); }
  .band--lav .rows { border-color: rgba(0, 0, 0, .3); }
  .band--lav .rows li { border-color: rgba(0, 0, 0, .15); }
  .band--lav .rows .n { color: var(--brand); }
  .band--lav .rows p { color: var(--stone-ink-2); }
  .ph { width: 100%; aspect-ratio: 4 / 5; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mq { overflow: hidden; border-block: 1px solid var(--line-strong); padding-block: var(--s-4); }
  .mq-track { display: flex; width: max-content; animation: mq-slide 42s linear infinite; }
  .mq-copy { display: flex; flex-shrink: 0; }
  .mq-copy span { font-family: var(--font-title); font-size: var(--t-2xl); line-height: 1.1; white-space: nowrap; display: inline-flex; align-items: center; gap: var(--s-6); padding-right: var(--s-6); }
  .mq-copy span::after { content: ""; width: 12px; height: 12px; background: var(--accent-ink); transform: rotate(45deg); }
  @keyframes mq-slide { to { transform: translateX(-50%); } }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .head { grid-template-columns: 1fr; gap: var(--s-3); }
    .idx { font-size: 4rem; }
    .rows li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--s-3) var(--s-4); }
    .rows li p { grid-column: 2; }
    .band { padding-block: var(--s-8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-track { width: auto; flex-wrap: wrap; }
    .mq-copy[aria-hidden="true"] { display: none; }
    .mq-copy { flex-wrap: wrap; }
  }

  .big-words { font-family: var(--font-title); font-size: var(--t-2xl); line-height: 1.08; max-width: 22ch; margin-bottom: var(--s-8); }
  .defs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); margin: 0; }
  .defs > div { border-top: 1px solid var(--line-strong); padding-top: var(--s-3); }
  .defs dt { font-family: var(--font-wide); font-size: .6875rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--accent-ink); margin-bottom: var(--s-2); }
  .defs dd { margin: 0; color: var(--ink-2); font-size: var(--t-sm); }
  .frc { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--s-8); align-items: end; }
  .frc h2 { font-size: var(--t-3xl); line-height: 1; }
  .frc p { font-size: var(--t-lg); }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: var(--s-8) 0 0; border-top: 1px solid rgba(0, 0, 0, .3); }
  .stats > div { padding: var(--s-5) var(--s-4) 0 0; }
  .stats > div + div { padding-left: var(--s-4); border-left: 1px solid rgba(0, 0, 0, .18); }
  .stats dt { font-family: var(--font-title); font-size: var(--t-3xl); line-height: 1; transform-origin: left bottom; animation: stat-pop 5s var(--ease) infinite; }
  .stats > div:nth-child(2) dt { animation-delay: .4s; }
  .stats > div:nth-child(3) dt { animation-delay: .8s; }
  .stats > div:nth-child(4) dt { animation-delay: 1.2s; }
  .stats dd { margin: var(--s-2) 0 0; font-size: var(--t-sm); color: var(--stone-ink-2); }
  @keyframes stat-pop { 0%, 70%, 100% { transform: scale(1); } 80% { transform: scale(1.08); } 90% { transform: scale(1); } }
  .learn { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: start; }
  .learn .ph { max-width: 440px; }
  .ph--wide { aspect-ratio: 5 / 4; }
  .learn .rows li { grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.3fr); }
  .final { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-6); }
  .final h2 { font-size: var(--t-3xl); line-height: 1; max-width: 12ch; }
  .final p { max-width: 40ch; margin-top: var(--s-4); font-size: var(--t-lg); }
  @media (max-width: 960px) {
    .defs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .frc, .learn { grid-template-columns: 1fr; gap: var(--s-6); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .stats > div:nth-child(n+3) { border-top: 1px solid rgba(0,0,0,.18); margin-top: var(--s-5); }
    .learn .ph { max-width: 320px; }
  }
  @media (max-width: 480px) { .defs { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .stats dt { animation: none; } }
</style>

</BaseLayout>
