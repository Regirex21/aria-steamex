---
// src/pages/sponsors.astro
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout
  title="Sponsors y aliados | ARIA STEAMEX"
  description="Empresas que impulsan a ARIA STEAMEX y las formas de colaborar con el equipo: visibilidad, impacto y talento femenil en STEM."
>
  <main>

    <section class="wrap s-hero">
      <div class="s-txt">
        <p class="wide">Patrocinio y alianzas</p>
        <h1>Impulsamos talento con aliados reales</h1>
        <p class="s-lede">ARIA STEAMEX busca empresas, instituciones y personas que quieran invertir en liderazgo femenil, educación STEM e impacto comunitario en México.</p>
        <div class="s-actions">
          <a href="/contacto" class="btn">Quiero patrocinar<svg class="arw arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
          <a href="#tiers" class="btn btn--line">Ver formas de apoyar</a>
        </div>
      </div>
      <div class="s-photo">
        <div class="photo-corner">
          <img src="/assets/equipo/img-7248.jpg" alt="Integrantes de ARIA armando el robot, con la placa morada y electrónica a la vista" width="1200" height="1500" decoding="async" />
        </div>
      </div>
    </section>

    <section class="why on-stone">
      <div class="wrap">
        <div class="why-head">
          <p class="wide">Por qué apoyar</p>
          <h2>Una alianza con impacto, visibilidad y futuro.</h2>
        </div>
        <div class="why-grid">
          <div class="why-i">
            <span class="why-n">01</span>
            <h3>Marca</h3>
            <p>Presencia en robot, uniformes y contenido.</p>
          </div>
          <div class="why-i">
            <span class="why-n">02</span>
            <h3>Impacto</h3>
            <p>Difusión y oportunidades reales para jóvenes.</p>
          </div>
          <div class="why-i">
            <span class="why-n">03</span>
            <h3>STEM</h3>
            <p>Educación aplicada e ingeniería competitiva.</p>
          </div>
          <div class="why-i">
            <span class="why-n">04</span>
            <h3>México</h3>
            <p>Talento nacional con proyección internacional.</p>
          </div>
        </div>
        <p class="why-p">ARIA STEAMEX conecta a las empresas con la innovación, el liderazgo femenil y el desarrollo de talento STEM en México.</p>
      </div>
    </section>

    <section class="wrap allies">
      <div class="allies-head">
        <p class="wide">Aliados</p>
        <h2>Empresas que creen en el futuro</h2>
      </div>
      <ul class="wall">
          <li><img src="/assets/sponsors/gene-haas.jpg" alt="Gene Haas Foundation" loading="lazy" decoding="async" /></li>
          <li><img src="/assets/sponsors/intuitive.jpg" alt="Intuitive Foundation" loading="lazy" decoding="async" /></li>
          <li><img src="/assets/sponsors/boeing.jpg" alt="Boeing" loading="lazy" decoding="async" /></li>
          <li><img src="/assets/sponsors/solveurs-travel.png" alt="Solveurs Travel" loading="lazy" decoding="async" /></li>
      </ul>
    </section>

    <section id="tiers" class="tiers">
      <div class="wrap">
        <div class="tiers-head">
          <p class="wide">Oportunidades</p>
          <h2>Formas de colaborar</h2>
        </div>
        <ul class="tier-list">
          <li>
            <a class="tier" href="/contacto">
              <span class="tier-n">01</span>
              <span class="tier-t"><span class="wide">Apoyo técnico</span><strong>Herramientas y talento</strong></span>
              <span class="tier-d">Materiales, herramientas, manufactura, software o mentoría técnica.</span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="tier" href="/contacto">
              <span class="tier-n">02</span>
              <span class="tier-t"><span class="wide">Apoyo económico</span><strong>Recursos para competir</strong></span>
              <span class="tier-d">Registro, viajes, piezas, operación y crecimiento del programa.</span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
          <li>
            <a class="tier" href="/contacto">
              <span class="tier-n">03</span>
              <span class="tier-t"><span class="wide">Apoyo estratégico</span><strong>Alianza a largo plazo</strong></span>
              <span class="tier-d">Colaboraciones educativas, eventos y posicionamiento conjunto.</span>
              <svg class="arw" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="cta">
      <div class="wrap cta-in">
        <h2>Construyamos impacto juntos</h2>
        <div>
          <p>Si tu empresa valora la innovación, el liderazgo y el futuro, hablemos.</p>
          <div class="s-actions">
            <a href="/contacto" class="btn">Contactar<svg class="arw arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h17M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
            <a href="/nosotras" class="btn btn--line">Conocer ARIA</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .arw { width: 1em; height: 1em; flex: none; transition: transform var(--dur) var(--ease); }

  .s-hero { display: grid; grid-template-columns: 7fr 5fr; gap: var(--s-8); align-items: center; padding-block: var(--s-8) var(--s-9); }
  .s-txt h1 { font-size: var(--t-3xl); margin: var(--s-4) 0 var(--s-5); color: var(--cream); max-width: 12ch; }
  .s-lede { color: var(--ink-2); font-size: var(--t-lg); max-width: 46ch; }
  .s-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .s-photo { position: relative; padding: 0 var(--s-5) var(--s-5) 0; }
  .s-photo::after {
    content: ""; position: absolute; inset: var(--s-5) 0 0 var(--s-5); z-index: 0;
    border: 1px solid var(--accent); border-radius: 150px 18px 18px 18px;
  }
  .s-photo .photo-corner { position: relative; z-index: 1; aspect-ratio: 4 / 5; }
  .s-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; display: block; }

  .why { padding-block: var(--s-9); }
  .why-head { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-6); align-items: start; margin-bottom: var(--s-8); }
  .why-head h2 { font-size: var(--t-2xl); max-width: 14ch; }
  .why :global(.wide) { color: var(--stone-ink-2); }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6); }
  .why-i { border-top: 2px solid var(--stone-ink); padding-top: var(--s-4); }
  .why-n { font-family: var(--font-wide); font-size: .6875rem; letter-spacing: .14em; color: var(--stone-ink-2); font-weight: 700; }
  .why-i h3 { font: 400 clamp(2rem, 3.4vw, 3rem)/1.05 var(--font-title); margin: var(--s-3) 0 var(--s-3); }
  .why-i p { color: var(--stone-ink-2); }
  .why-p { margin-top: var(--s-8); max-width: 52ch; font: 400 var(--t-xl)/1.3 var(--font-title); color: var(--stone-ink); }

  .allies { padding-block: var(--s-9); }
  .allies-head { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-6); align-items: start; margin-bottom: var(--s-7); }
  .allies-head h2 { font-size: var(--t-2xl); max-width: 14ch; }
  .wall { list-style: none; margin: 0; padding: 1px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line-strong); }
  .wall li { background: #fff; min-height: 200px; display: grid; place-items: center; padding: var(--s-5); overflow: hidden; }
  .wall img { max-width: 100%; max-height: 140px; object-fit: contain; transition: transform var(--dur-slow) var(--ease); }
  .wall li:hover img { transform: scale(1.06); }

  .tiers { background: var(--bg-2); padding-block: var(--s-9); }
  .tiers-head { margin-bottom: var(--s-7); }
  .tiers-head h2 { font-size: var(--t-2xl); margin-top: var(--s-3); }
  .tier-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line-strong); }
  .tier {
    position: relative; display: grid; grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 4fr) auto; gap: var(--s-5); align-items: center;
    padding: var(--s-6) 0; border-top: 1px solid var(--line-strong); color: var(--ink); text-decoration: none;
  }
  .tier::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-slow) var(--ease);
  }
  .tier:hover::before, .tier:focus-visible::before { transform: scaleX(1); }
  .tier-n { font-family: var(--font-title); font-size: 1.6rem; color: var(--accent-ink); }
  .tier-t { display: grid; gap: var(--s-2); transition: transform var(--dur) var(--ease); }
  .tier-t .wide { color: var(--ink-2); }
  .tier-t strong { font: 400 clamp(2rem, 4.4vw, 3.6rem)/1.02 var(--font-title); color: var(--cream); }
  .tier-d { color: var(--ink-2); max-width: 40ch; }
  .tier .arw { width: 1.8rem; height: 1.8rem; }
  .tier:hover .tier-t, .tier:hover .arw { transform: translateX(10px); }

  .cta { background: var(--accent); color: var(--on-accent); padding-block: var(--s-9); }
  .cta-in { display: grid; grid-template-columns: 7fr 5fr; gap: var(--s-7); align-items: end; }
  .cta h2 { font-size: var(--t-3xl); line-height: 1; max-width: 11ch; }
  .cta p { font-size: var(--t-lg); max-width: 34ch; }
  .cta .btn { --btn-bg: var(--bg); --btn-ink: var(--ink); --btn-fill: var(--cream); --btn-fill-ink: var(--bg); }
  .cta .btn--line { --btn-bg: transparent; --btn-ink: var(--on-accent); --btn-fill: var(--bg); --btn-fill-ink: var(--ink); box-shadow: inset 0 0 0 1px var(--on-accent); }

  @media (max-width: 960px) {
    .s-hero, .why-head, .allies-head, .cta-in { grid-template-columns: 1fr; gap: var(--s-6); }
    .s-photo { max-width: 460px; }
    .why-grid { grid-template-columns: 1fr 1fr; }
    .wall { grid-template-columns: 1fr 1fr; }
    .tier { grid-template-columns: 3rem minmax(0, 1fr) auto; gap: var(--s-3) var(--s-4); }
    .tier-d { grid-column: 2; grid-row: 2; }
    .tier .arw { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 560px) {
    .why-grid { grid-template-columns: 1fr; }
    .s-hero { padding-block: var(--s-6) var(--s-8); }
    .why, .allies, .tiers, .cta { padding-block: var(--s-8); }
  }
</style>
